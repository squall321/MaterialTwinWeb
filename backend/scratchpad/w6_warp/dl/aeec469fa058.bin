                            							<div class="item layout01">
                                <div class="item-inner">
									<div class="figure wow fadeInLeft" data-wow-duration="1s">
										<img src="https://www.tuc.com.tw/upfile/web/8076cd8c5d4205ec9598714ed2d5e77b78395ff1_a.jpg" width="1000" height="450" alt="" />
									</div>
									<div class="text wow fadeInRight" data-wow-duration="1s">
										<h3>Radio Frequency</h3>
										<p>Designed for Advanced mmWave Multilayer & Hybrid Materials</p>

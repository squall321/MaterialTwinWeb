<script language="javascript">
	$(document).ready(function(e) {
        $('#HxHeaderQuery').click(function(e) {
            location.href	= 'https://www.tuc.com.tw/en-us/search/keyword/'+$('#HxHeaderWord').val();
			return false;
        });
		$('#HxLogin').click(function(e) {
            location.href	= 'https://www.tuc.com.tw/en-us/login/back/en-global--product--TU-872-SLK';
			return false;
        });
		$('#cookie-ok').click(function() {
			$.getJSON('https://www.tuc.com.tw/_ajax.code.php', {'work':'cookie-accept'}, function(result){
				if(result.id == 0)
					$('#cookie-accept').hide();
				return false;
			});
			return false;
		});
    });
	function enter2query(e){
		var code;
		if (!e){
			var e = window.event;
		}  
		if(e.keyCode){
			code = e.keyCode;
		} else if(e.which){
			code = e.which;
		}
		if (code == 13){
			$('#HxHeaderQuery').click();
		} 
	}
</script>

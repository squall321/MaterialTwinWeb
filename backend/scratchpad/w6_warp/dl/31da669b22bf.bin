<script>
  jQuery(document).ready(function ($) {
    if ($(window).width() < 1024) {
      $("ul.main-nav > li a").click(function () {
        if ($(".sub-menu-block").is(":visible")) {
          $(".sub-menu-block").slideUp(300);
          $(".menu-arrow-bg").text("+");
        }
        if ($(this).next(".sub-menu-block").is(":visible")) {
          $(this).next(".sub-menu-block").slideUp(300);
          $(this).children(".menu-arrow-bg").text("+");
        } else {
          $(this).next(".sub-menu-block").slideDown(300);
          $(this).children(".menu-arrow-bg").text("-");
        }
      });
    }

    $(".menu_repeat").each(function () {
      var menuItem = $(this);
      var menu = menuItem.find(".menu_inner");
      var submenu = menuItem.find(".inner_menu");
      var arrowInnerRight = menuItem.find(".arrowRight");
      arrowInnerRight.on("click", function (e) {
        if (window.matchMedia('only screen and (max-width:1024px)').matches) {
          e.preventDefault();
          var isActive = menu.hasClass("active");
          closeAllMenus();
          if (!isActive) {
            showSubmenu(submenu, menu);
          }
        }
      });
    });

    function closeAllMenus() {
      $(".menu_repeat").each(function () {
        var menu = $(this).find(".menu_inner");
        var submenu = $(this).find(".inner_menu");
        if (menu.hasClass("active")) {
          hideSubmenu(submenu, menu);
        }
      });
    }

    function showSubmenu(submenu, menu) {
      submenu.css({ visibility: "visible", opacity: "1", pointerEvents: "auto" });
      menu.addClass("active").attr("aria-expanded", "true");
    }

    function hideSubmenu(submenu, menu) {
      submenu.css({ visibility: "hidden", opacity: "0", pointerEvents: "none" });
      menu.removeClass("active").attr("aria-expanded", "false");
    }

    //   var selector = ".main-nav li";

    //   $(selector).on("click", function (e) {
    //     if (!$(e.target).is("a")) {

    //       if ($(this).hasClass("active")) {        
    //         $(this).removeClass("active");         
    //       } else {        
    //         $(selector).removeClass("active");
    //         $(this).addClass("active");
    //       }
    //     }
    //   });
    //     $('.top-level-link').on("click", function () {
    //       if ($(this).hasClass("active")) {   
    //         $(this).removeClass("active")
    //       }
    //       else{
    //         $(this).addClass("active")
    //         $(this).siblings().removeClass("active");
    //       }
    //     })

    $('.top-level-link a:not(.mega-menu--no-dropdown)').on("click", function () {
      if ($(this).parent('.top-level-link').hasClass("active")) {  
        $(this).parent('.top-level-link').removeClass("active");
      }
      else{
        $(this).parent('.top-level-link').addClass("active");
        $(this).parent('.top-level-link').siblings().removeClass("active");
      }

    })


    /*$(window).on("scroll", function () {
      $(selector).removeClass("active");
    });*/


  });




</script>



<mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="m74" overflow="scroll"><mml:mrow><mml:msub><mml:mi mathvariant="normal">σ</mml:mi><mml:mrow><mml:mi mathvariant="normal">SE</mml:mi></mml:mrow></mml:msub></mml:mrow></mml:math>
</inline-formula>
<sup>2</sup>
</th><th align="center" rowspan="1" colspan="1">
<inline-formula id="inf63">
<mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="m75" overflow="scroll"><mml:mrow><mml:msub><mml:mi mathvariant="normal">µ</mml:mi><mml:mrow><mml:mi mathvariant="normal">SE</mml:mi></mml:mrow></mml:msub></mml:mrow></mml:math>
</inline-formula>
<sup>2</sup>
</th><th align="center" rowspan="1" colspan="1">
<inline-formula id="inf64">
<mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="m76" overflow="scroll"><mml:mrow><mml:msub><mml:mi mathvariant="normal">σ</mml:mi><mml:mrow><mml:mi mathvariant="normal">SE</mml:mi></mml:mrow></mml:msub></mml:mrow></mml:math>
</inline-formula>
<sup>2</sup>
</th><th align="center" rowspan="1" colspan="1">
<inline-formula id="inf65">
<mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="m77" overflow="scroll"><mml:mrow><mml:msub><mml:mi mathvariant="normal">µ</mml:mi><mml:mrow><mml:mi mathvariant="normal">SE</mml:mi></mml:mrow></mml:msub></mml:mrow></mml:math>
</inline-formula>
<sup>2</sup>

.70</td><td align="center" valign="middle" style="border-bottom:solid thin" rowspan="1" colspan="1">2.21</td></tr><tr><td align="center" valign="middle" style="border-bottom:solid thin" rowspan="1" colspan="1">10</td><td align="center" valign="middle" style="border-bottom:solid thin" rowspan="1" colspan="1">58.46 ± 1.20</td><td align="center" valign="middle" style="border-bottom:solid thin" rowspan="1" colspan="1">8.74</td><td align="center" valign="middle" style="border-bottom:solid thin" rowspan="1" colspan="1">53.43 ± 0.90</td><td align="center" valign="middle" style="border-bottom:solid thin" rowspan="1" colspan="1">6.43</td></tr><tr><td align="center" valign="middle" style="border-bottom:solid thin" rowspan="1" colspan="1">15</td><td align="center" valign="middle" style="border-bottom:solid thin" rowspan="1" colspan="1">58.87</td><td align="center" valign="middle" style="border-bottom:solid thin" rowspan="1" colspan="1">9.51</td><td align="center" valign="middle" style="border-bottom:solid thin" rowspan="1" colspan="1">54.98</td><td align="center" valign="middle" style="border-bottom:solid thin" rowspan="1" colspan="1">9.52</td></tr><tr><td align="center" valign="middle" style="border-bottom:solid thin" rowspan="1" colspan="1">

			<section>
			<a name="Mechanical" class="anchor"></a>
			<h2>Mechanical Properties</h2>
			<div class="split data break-mid">
			<div><div class='mech'><p>Elastic (Young's, Tensile) Modulus</p><div class="data-bars"><span style="width: 30%;"></span><span style="width: 30%;"></span></div><div class="data-bars"><span style="width: 1.25%;"></span><span style="width: 1.25%;"></span></div><div class="data-bars"><span style="width: 0.028571428571429%;"></span><span style="width: 0.028571428571425%;"></span></div><p>0.3 <i>GPa</i> <span class="float-right">0.044 <i>x 10<sup>6</sup> psi</i></span></p></div><div class='mech'><p>Shear Modulus</p><div class="data-bars"><span style="width: 24.705882352941%;"></span><span style="width: 24.705882352941%;"></span></div><div class="data-bars"><span style="width: 8.75%;"></span><span style="width: 8.75%;"></span></div><div class="data-bars"><span style="width: 0.11666666666667%;"></span><span style="width: 0.11666666666667%;"></span></div><p>0.21 <i>GPa</i> <span class="float-right">0.030 <i>x 10<sup>6</sup> psi</i></span></p></div></div><div><div class='mech'><p>Tensile Strength: Ultimate (UTS)</p><div class="data-bars"><span style="width: 8.75%;"></span><span style="width: 8.75%;"></span></div><div class="data-bars"><span style="width: 2.8%;"></span><span style="width: 2.8%;"></span></div><div class="data-bars"><span style="width: 0.2834008097166%;"></span><span style="width: 0.2834008097166%;"></span></div><p>7.0 <i>MPa</i> <span class="float-right">1.0 <i>x 10<sup>3</sup> psi</i></span></p></div></div>			</div>
		</section>
				<section>
			<a name="Thermal" class="anchor"></a>
			<h2>Thermal Properties</h2>
			<div class="split data break-mid">
			<div><div class='therm'><p>Glass Transition Temperature</p><div class="data-bars"><span style="width: 0%;"></span><span style="width: 0%;"></span></div><div class="data-bars"><span style="width: 0%;"></span><span style="width: 0%;"></span></div><div class="data-bars"><span style="width: 0%;"></span><span style="width: 0%;"></span></div><p>-130 <i>&deg;C</i> <span class="float-right">-190 <i>&deg;F</i></span></p></div><div class='therm'><p>Maximum Temperature: Autoignition</p><div class="data-bars"><span style="width: 100%;"></span><span style="width: 100%;"></span></div><div class="data-bars"><span style="width: 59.375%;"></span><span style="width: 59.375%;"></span></div><div class="data-bars"><span style="width: 59.375%;"></span><span style="width: 59.375%;"></span></div><p>380 <i>&deg;C</i> <span class="float-right">710 <i>&deg;F</i></span></p></div></div><div><div class='therm'><p>Maximum Temperature: Decomposition</p><div class="data-bars"><span style="width: 97.560975609756%;"></span><span style="width: 97.560975609756%;"></span></div><div class="data-bars"><span style="width: 70.175438596491%;"></span><span style="width: 70.175438596491%;"></span></div><div class="data-bars"><span style="width: 36.363636363636%;"></span><span style="width: 36.363636363636%;"></span></div><p>400 <i>&deg;C</i> <span class="float-right">750 <i>&deg;F</i></span></p></div><div class='therm'><p>Melting Onset (Solidus)</p><div class="data-bars"><span style="width: 84.615384615385%;"></span><span style="width: 84.615384615385%;"></span></div><div class="data-bars"><span style="width: 32.352941176471%;"></span><span style="width: 32.352941176471%;"></span></div><div class="data-bars"><span style="width: 3.7931034482759%;"></span><span style="width: 3.7931034482759%;"></span></div><p>110 <i>&deg;C</i> <span class="float-right">230 <i>&deg;F</i></span></p></div></div><div><div class='therm'><p>Specific Heat Capacity</p><div class="data-bars"><span style="width: 95.833333333333%;"></span><span style="width: 95.833333333333%;"></span></div><div class="data-bars"><span style="width: 95.833333333333%;"></span><span style="width: 95.833333333333%;"></span></div><div class="data-bars"><span style="width: 95.833333333333%;"></span><span style="width: 95.833333333333%;"></span></div><p>2300 <i>J/kg-K</i> <span class="float-right">0.55 <i>BTU/lb-&deg;F</i></span></p></div><div class='therm'><p>Thermal Conductivity</p><div class="data-bars"><span style="width: 80%;"></span><span style="width: 80%;"></span></div><div class="data-bars"><span style="width: 38.709677419355%;"></span><span style="width: 38.709677419355%;"></span></div><div class="data-bars"><span style="width: 0.018947368421053%;"></span><span style="width: 0.018947368421053%;"></span></div><p>0.36 <i>W/m-K</i> <span class="float-right">0.21 <i>BTU/h-ft-&deg;F</i></span></p></div></div><div><div class='therm'><p>Thermal Expansion</p><div class="data-bars"><span style="width: 100%;"></span><span style="width: 100%;"></span></div><div class="data-bars"><span style="width: 100%;"></span><span style="width: 100%;"></span></div><div class="data-bars"><span style="width: 33.846153846154%;"></span><span style="width: 33.846153846154%;"></span></div><p>220 <i>&micro;m/m-K</i></p></div><div class='therm'><p>Vicat Softening Temperature</p><div class="data-bars"><span style="width: 66.666666666667%;"></span><span style="width: 66.666666666667%;"></span></div><div class="data-bars"><span style="width: 17.241379310345%;"></span><span style="width: 17.241379310345%;"></span></div><div class="data-bars"><span style="width: 12.5%;"></span><span style="width: 12.5%;"></span></div><p>50 <i>&deg;C</i> <span class="float-right">120 <i>&deg;F</i></span></p></div></div>			</div>
		</section>
				<section>
			<a name="Other" class="anchor"></a>
			<h2>Other Material Properties</h2>
			<div class="split data break-mid">
			<div><div class='other'><p>Density</p><div class="data-bars"><span style="width: 70.769230769231%;"></span><span style="width: 70.769230769231%;"></span></div><div class="data-bars"><span style="width: 40%;"></span><span style="width: 40%;"></span></div><div class="data-bars"><span style="width: 4.1818181818182%;"></span><span style="width: 4.1818181818182%;"></span></div><p>0.92 <i>g/cm<sup>3</sup></i> <span class="float-right">57 <i>lb/ft<sup>3</sup></i></span></p></div><div class='ele'><p>Dielectric Constant (Relative Permittivity) At 1 Hz</p><div class="data-bars"><span style="width: 95.833333333333%;"></span><span style="width: 95.833333333333%;"></span></div><div class="data-bars"><span style="width: 10.454545454545%;"></span><span style="width: 10.454545454545%;"></span></div><div class="data-bars"><span style="width: 3.2857142857143%;"></span><span style="width: 3.2857142857143%;"></span></div><p>2.3</p></div></div>			</div>
		</section>
				<section>
			<a name="Calculations" class="anchor"></a>
			<h2>Common Calculations</h2>
			<div class="split data break-mid">
			<div><div class='common'><p>Stiffness to Weight: Axial</p><div class="data-bars"><span style="width: 31.034482758621%;"></span><span style="width: 31.034482758621%;"></span></div><div class="data-bars"><span style="width: 1.8%;"></span><span style="width: 1.8%;"></span></div><div class="data-bars"><span style="width: 0.10588235294118%;"></span><span style="width: 0.10588235294118%;"></span></div><p>0.18 <i>points</i></p></div><div class='common'><p>Stiffness to Weight: Bending</p><div class="data-bars"><span style="width: 68.571428571429%;"></span><span style="width: 68.571428571429%;"></span></div><div class="data-bars"><span style="width: 32.876712328767%;"></span><span style="width: 32.876712328767%;"></span></div><div class="data-bars"><span style="width: 20%;"></span><span style="width: 20%;"></span></div><p>24 <i>points</i></p></div></div><div><div class='common'><p>Strength to Weight: Axial</p><div class="data-bars"><span style="width: 12.352941176471%;"></span><span style="width: 12.352941176471%;"></span></div><div class="data-bars"><span style="width: 4.2%;"></span><span style="width: 4.2%;"></span></div><div class="data-bars"><span style="width: 1.2352941176471%;"></span><span style="width: 1.2352941176471%;"></span></div><p>2.1 <i>points</i></p></div><div class='common'><p>Strength to Weight: Bending</p><div class="data-bars"><span style="width: 27.5%;"></span><span style="width: 27.5%;"></span></div><div class="data-bars"><span style="width: 13.538461538462%;"></span><span style="width: 13.538461538462%;"></span></div><div class="data-bars"><span style="width: 8.8%;"></span><span style="width: 8.8%;"></span></div><p>8.8 <i>points</i></p></div></div><div><div class='common'><p>Thermal Diffusivity</p><div class="data-bars"><span style="width: 68%;"></span><span style="width: 68%;"></span></div><div class="data-bars"><span style="width: 33.333333333333%;"></span><span style="width: 33.333333333333%;"></span></div><div class="data-bars"><span style="width: 0.015740740740741%;"></span><span style="width: 0.015740740740739%;"></span></div><p>0.17 <i>mm<sup>2</sup>/s</i></p></div><div class='common'><p>Thermal Shock Resistance</p><div class="data-bars"><span style="width: 30.4%;"></span><span style="width: 30.4%;"></span></div><div class="data-bars"><span style="width: 6.9090909090909%;"></span><span style="width: 6.9090909090909%;"></span></div><div class="data-bars"><span style="width: 5.8461538461538%;"></span><span style="width: 5.8461538461538%;"></span></div><p>7.6 <i>points</i></p></div></div>			</div>
		</section>

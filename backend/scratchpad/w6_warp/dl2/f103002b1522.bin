<?xml version="1.0" encoding="UTF-8"?><article xml:lang="en" article-type="research-article"><front><journal-meta><journal-id journal-id-type="pmc-domain-id">3551</journal-id><journal-id journal-id-type="pmc-domain">micronano</journal-id><journal-title-group><journal-title>Microsystems &amp; Nanoengineering</journal-title><abbrev-journal-title>Microsyst Nanoeng</abbrev-journal-title></journal-title-group><publisher><publisher-name>Nature Publishing Group</publisher-name></publisher></journal-meta><article-meta><article-id pub-id-type="pmcid">PMC13284314</article-id><article-id pub-id-type="pmcaid">13284314</article-id><article-id pub-id-type="pmcaiid">13284314</article-id><article-id pub-id-type="pmid">42324252</article-id><article-id pub-id-type="doi">10.1038/s41378-026-01342-w</article-id><title-group><article-title>A unified viscoelastic-viscoplastic constitutive framework for optically clear adhesives: Experiments, modeling, and FE validation</article-title></title-group><contrib-group content-type="author"><contrib><name name-style="western"><surname>Zhou</surname><given-names initials="Z">Zhaoxu</given-names></name><xref ref-type="aff" rid="Aff1">1</xref><xref ref-type="aff" rid="Aff2">2</xref></contrib><contrib><name name-style="western"><surname>Liu</surname><given-names initials="Q">Qiying</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib><name name-style="western"><surname>Chen</surname><given-names initials="Y">Yujia</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib><name name-style="western"><surname>Tang</surname><given-names initials="S">Suilang</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib><name name-style="western"><surname>He</surname><given-names initials="S">Siyu</given-names></name><xref ref-type="aff" rid="Aff3">3</xref></contrib><contrib><name name-style="western"><surname>Tang</surname><given-names initials="F">Feixiang</given-names></name><xref ref-type="aff" rid="Aff2">2</xref><xref ref-type="aff" rid="Aff4">4</xref><xref ref-type="author-notes" rid="_fncrsp93pmc__">✉</xref></contrib><contrib><name name-style="western"><surname>Liu</surname><given-names initials="S">Sheng</given-names></name><xref ref-type="aff" rid="Aff1">1</xref><xref ref-type="aff" rid="Aff3">3</xref><xref ref-type="author-notes" rid="_fncrsp93pmc__">✉</xref></contrib></contrib-group><aff id="Aff1"><label>1</label>KeyLaboratory of Transients in Hydraulic Machinery, Ministry of Education, School of Power and Mechanical Engineering, Wuhan University, Wuhan, China </aff><aff id="Aff2"><label>2</label>Innvoation School of Integrated Circuits, Hefei University of Technology, Hefei, China </aff><aff id="Aff3"><label>3</label>School of Integrated Circuits, Wuhan University, Wuhan, China </aff><aff id="Aff4"><label>4</label>School of Microelectronics, Hefei University of Technology, Hefei, China </aff><author-notes><fn id="_fncrsp93pmc__"><label>✉</label><p>Corresponding author.</p></fn></author-notes><pub-date><day>22</day><month>6</month><year>2026</year></pub-date><volume>12</volume><fpage>243</fpage><page-range>243</page-range><pub-history><event event-type="pmc-release"><date><day>23</day><month>6</month><year>2026</year></date></event></pub-history><permissions><copyright-statement>© The Author(s) 2026</copyright-statement><license><license-p><bold>Open Access</bold> This article is licensed under a Creative Commons Attribution-NonCommercial-NoDerivatives 4.0 International License, which permits any non-commercial use, sharing, distribution and reproduction in any medium or format, as long as you give appropriate credit to the original author(s) and the source, provide a link to the Creative Commons licence, and indicate if you modified the licensed material. You do not have permission under this licence to share adapted material derived from this article or parts of it. The images or other third party material in this article are included in the article’s Creative Commons licence, unless indicated otherwise in a credit line to the material. If material is not included in the article’s Creative Commons licence and your intended use is not permitted by statutory regulation or exceeds the permitted use, you will need to obtain permission directly from the copyright holder. To view a copy of this licence, visit <ext-link xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="https://creativecommons.org/licenses/by-nc-nd/4.0/" ext-link-type="uri">http://creativecommons.org/licenses/by-nc-nd/4.0/</ext-link>.</license-p></license></permissions><self-uri xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="41378_2026_Article_1342.pdf" content-type="pmc-pdf"><?cloudpmc-path 3fd8/13284314/c5b87b381a11/41378_2026_Article_1342.pdf?><?cloudpmc-bucket app?><?size 1776426?></self-uri><abstract id="Abs1"><title>Abstract</title><p id="Par1">Optically clear adhesives (OCAs) are extensively employed as bonding layers in display manufacturing. As compliant interlayers in foldable display stacks, they undergo pronounced time and temperature -dependent deformation during repeated bending, which makes reliable constitutive characterization essential for accurate stress prediction and design optimization. Therefore, accurately characterizing their mechanical behavior is fundamental to bending-stress analysis and design optimization of foldable displays. Existing studies emphasize viscoelastic or hyperelastic behavior yet overlook the coupled viscoelastic-viscoplastic response. We propose a unified constitutive framework combining a generalized Maxwell representation with the Qian-Liu viscoplastic formulation to characterize OCA mechanics. The proposed model is calibrated against stress-relaxation experiments conducted at 30, 60, and 85 °C, from which the corresponding material parameters are identified; the fitting results demonstrate that the model captures the coupled viscoelastic-viscoplastic behavior under these conditions. The framework is further implemented into an ABAQUS UMAT and validated via finite-element simulations of a simplified foldable-display structure, which corroborate the experimental observations. The framework closes a gap in OCA constitutive modeling and delivers a calibrated, numerically validated tool for structural optimization and long-term reliability assessment of flexible OLED devices.</p>
<graphic xmlns:xlink="http://www.w3.org/1999/xlink" content-type="image" id="d33e215" xlink:href="41378_2026_1342_Figa_HTML.jpg"><?cloudpmc-path blobs/3fd8/13284314/261d5be83a0c/41378_2026_1342_Figa_HTML.jpg?><?cloudpmc-bucket cdn?><?image-server-status NEED_LOADING?><?original-height 498?><?original-width 925?><?scaled-height 332?><?scaled-width 616?></graphic>
<sec id="kwd-group1" sec-type="kwd-group" disp-level="2"><p><bold>Subject terms:</bold> Structural properties, Engineering</p></sec></abstract><custom-meta-group><custom-meta><meta-name>status</meta-name><meta-value>released</meta-value></custom-meta><custom-meta><meta-name>display-pdf</meta-name><meta-value>yes</meta-value></custom-meta><custom-meta><meta-name>is-olf</meta-name><meta-value>no</meta-value></custom-meta><custom-meta><meta-name>is-manuscript</meta-name><meta-value>no</meta-value></custom-meta><custom-meta><meta-name>is-preprint</meta-name><meta-value>no</meta-value></custom-meta><custom-meta><meta-name>is-journal-matter</meta-name><meta-value>no</meta-value></custom-meta><custom-meta><meta-name>is-scanned</meta-name><meta-value>no</meta-value></custom-meta><custom-meta><meta-name>is-retracted</meta-name><meta-value>no</meta-value></custom-meta></custom-meta-group></article-meta><notes notes-type="article-notes"><sec id="historyarticle-meta1" sec-type="history" disp-level="2"><p>Received 2025 Sep 8; Revised 2026 Apr 3; Accepted 2026 Apr 20; Collection date 2026.</p></sec></notes></front><body><sec id="Sec1" disp-level="1"><title>Introduction</title><p id="Par3">With the rapid advancement of display technologies, optically clear adhesives (OCA) have emerged as the preferred bonding material for transparent optical components owing to their outstanding mechanical properties, high optical transparency, strong adhesion capability, and long-term resistance to aging<sup><xref rid="CR1" ref-type="bibr">1</xref>–<xref rid="CR5" ref-type="bibr">5</xref></sup>. Flexible organic light-emitting diodes (OLEDs) and active-matrix OLEDs (AMOLEDs), characterized by high resolution, low power consumption, lightweight design, and wide viewing angles, play a pivotal role in the display industry. Their application scenarios continue to expand alongside the development of personal smart terminals, attracting widespread attention and being regarded as one of the most promising directions in future display technologies<sup><xref rid="CR6" ref-type="bibr">6</xref>–<xref rid="CR11" ref-type="bibr">11</xref></sup>. Flexible OLED panels typically adopt a stacked architecture, in which the functional layers are bonded by a soft and transparent OCA, forming an alternating “hard-soft-hard-soft” multilayer structure<sup><xref rid="CR12" ref-type="bibr">12</xref>,<xref rid="CR13" ref-type="bibr">13</xref></sup>. Within such laminated systems, the soft adhesive layer serves as a critical component that often undergoes significant shear deformation during bending. This layer not only provides sufficient interfacial adhesion but also functions as a stress-buffering medium to accommodate bending-induced deformation<sup><xref rid="CR14" ref-type="bibr">14</xref>,<xref rid="CR15" ref-type="bibr">15</xref></sup>. Therefore, prior to OLED structural design and rapid reliability assessment, it is essential to comprehensively characterize the mechanical behavior of OCA and to establish a physically reasonable constitutive model<sup><xref rid="CR16" ref-type="bibr">16</xref>–<xref rid="CR18" ref-type="bibr">18</xref></sup>.</p><p id="Par4">OCA is primarily synthesized through free-radical polymerization of acrylate monomers<sup><xref rid="CR19" ref-type="bibr">19</xref></sup>, and it generally exhibits visco-hyperelastic behavior<sup><xref rid="CR20" ref-type="bibr">20</xref></sup>. Numerous studies have investigated the constitutive modeling and finite element (FE) analysis of OCA. In 2014, Yeh et al. first employed FE methods to simulate the stress distribution in foldable OLED modules, analyzing the bending stresses in laminated foldable touch panels. In their study, OCA was simplified as a linear elastic material, without accounting for its inherent viscoelasticity or hyperelasticity<sup><xref rid="CR21" ref-type="bibr">21</xref></sup>. Ma et al. determined the hyperelastic and viscoelastic properties of OCA through uniaxial tensile, shear, and stress relaxation tests to obtain material parameters, and subsequently proposed a three-dimensional FE bending model for the OLED bending region<sup><xref rid="CR22" ref-type="bibr">22</xref></sup>. Zhang et al. further explored the hyperelastic and viscoelastic mechanical behavior of OCA by fitting experimental data with appropriate models, thereby elucidating the influence of temperature on its mechanical performance<sup><xref rid="CR23" ref-type="bibr">23</xref></sup>. Salmon et al. conducted FE simulations to examine the impact of the viscoelastic constitutive properties of 3 M OCA on the interlayer mechanical behavior of foldable display panel stacks, highlighting its crucial role in enhancing foldability<sup><xref rid="CR24" ref-type="bibr">24</xref></sup>. Zhao et al. considered the interplay between crosslinked networks, free chains, and entanglement constraints, successfully capturing the isotropic visco-hyperelastic behavior of OCA<sup><xref rid="CR25" ref-type="bibr">25</xref></sup>. Cheng et al. employed several phenomenological hyperelastic models to characterize OCA mechanics and applied them to bending simulations of AMOLED displays<sup><xref rid="CR26" ref-type="bibr">26</xref></sup>. Similarly, Jia et al. adopted a Yeoh hyperelastic framework to analyze bending stresses in foldable AMOLED panels incorporating OCA layers<sup><xref rid="CR27" ref-type="bibr">27</xref></sup>. Other studies focusing on multilayer structures in foldable displays have utilized FE methods to investigate bending stress regulation, neutral-plane optimization, and delamination prevention, aiming to improve the structural reliability of OCA-bonded systems<sup><xref rid="CR28" ref-type="bibr">28</xref>,<xref rid="CR29" ref-type="bibr">29</xref></sup>. Collectively, these investigations demonstrate a gradual evolution from simplified linear elastic representations of OCA toward more advanced hyperelastic, viscoelastic, and visco-hyperelastic constitutive models. However, the viscoelastic-viscoplastic characteristics of OCA have not yet been considered.</p><p id="Par5">Lee et al. observed that OCA exhibits permanent deformation during creep and stress relaxation measurements, which cannot be fully recovered upon stress removal<sup><xref rid="CR30" ref-type="bibr">30</xref></sup>. Similarly, Park et al. reported the presence of unrecoverable residual strain in creep-recovery tests of OCA<sup><xref rid="CR31" ref-type="bibr">31</xref></sup>, while Kim et al. demonstrated through strain recovery experiments that pristine adhesive films recover only 68% of the imposed strain, leaving approximately 32% as permanent, unrecoverable deformation<sup><xref rid="CR32" ref-type="bibr">32</xref></sup>. These phenomena are strongly aligned with the fundamental characteristics of viscoplastic materials. According to established theoretical frameworks, the total strain in viscoplastic materials can be decomposed into elastic and irreversible plastic components, wherein the irreversibility of plastic strain directly corresponds to the permanent deformation observed in OCA. The plastic strain rate is typically governed by a Norton-type relation with stress, reflecting both time and loading-rate dependencies-features that are consistent with the time-dependent permanent deformation of OCA. Despite the existence of partial static recovery, the pronounced residual strain in OCA unequivocally confirms the presence of plastic deformation, representing a prototypical viscoplastic response<sup><xref rid="CR33" ref-type="bibr">33</xref></sup>. Li et al. further proposed that the constitutive relationship of OCA can be categorized into three regimes: (i) the stress-strain response under rapid loading, (ii) the creep constitutive relation under sustained loading, and (iii) the stress-strain response during rapid unloading<sup><xref rid="CR34" ref-type="bibr">34</xref></sup>. Therefore, investigating the viscoelastic-viscoplastic constitutive behavior of OCA is of profound importance for a comprehensive understanding of its mechanical performance.</p><p id="Par6">To date, no studies have reported the development of a viscoelastic-viscoplastic constitutive model specifically for OCA. However, significant progress has been achieved in modeling other classes of adhesives. For example, Chen et al. proposed a one-dimensional nonlinear viscoelastic-viscoplastic model that couples the Schapery nonlinear single-integral formulation with the Perzyna viscoplastic framework, which successfully captured the mechanical behavior of adhesives<sup><xref rid="CR35" ref-type="bibr">35</xref></sup>. Groth employed three different viscoelastic-viscoplastic models to analyze stress states in single-lap adhesive joints with and without cracks<sup><xref rid="CR36" ref-type="bibr">36</xref></sup>. Liang et al. combined a multi-relaxation viscoelastic-viscoplastic formulation with a three-element viscoelastic model to construct a constitutive framework capable of describing the mechanical evolution of adhesives<sup><xref rid="CR37" ref-type="bibr">37</xref></sup>. Qi et al. developed an elastoviscoplastic model based on a rheological system composed of a Voigt element in series with a spring and in parallel with multiple Maxwell elements, effectively characterizing creep, relaxation, and stress-strain responses<sup><xref rid="CR38" ref-type="bibr">38</xref></sup>. Collectively, these studies provide a solid theoretical foundation, feasible modeling strategies, and robust validation methods that may guide the future development of a viscoelastic-viscoplastic constitutive model for OCA.</p><p id="Par7">In this context, the present work focuses on the coupled viscoelastic-viscoplastic mechanical behavior of OCA, aiming to establish a unified constitutive framework by integrating the generalized Maxwell viscoelastic model with the Qian-Liu viscoplastic formulation. Key parameters are extracted from stress relaxation experiments conducted under multiple temperature conditions, and the proposed model is validated through nonlinear regression and finite element simulations. This systematic approach enables the elucidation of temperature and time-dependent mechanisms governing the mechanical response of OCA. Beyond advancing the theoretical understanding, the proposed methodology provides accurate predictive tools for structural optimization and long-term reliability evaluation of flexible OLED devices, while simultaneously filling a critical gap in the field of viscoelastic-viscoplastic constitutive modeling.</p></sec><sec id="Sec2" disp-level="1"><title>Constitutive model</title><sec id="Sec3" disp-level="2"><title>Viscoelastic Constitutive Model</title><p id="Par8">OCA exhibits typical viscoelastic mechanical behaviors such as stress relaxation and creep, which can be effectively characterized by establishing an appropriate viscoelastic constitutive model. Commonly used viscoelastic models in related studies include the Maxwell model, the generalized Maxwell model, the Kelvin model, and various four-parameter models. To accurately describe the viscoelastic response of OCA, this study adopts Hookean springs and dashpots as the fundamental rheological elements, representing ideal elastic solids and viscous fluids, respectively. The static and dynamic viscoelastic responses of the material were systematically examined, and the generalized Maxwell model was selected to analyze the viscoelastic behavior of OCA.</p><p id="Par9">As illustrated in Fig. <xref rid="Fig1" ref-type="fig">1</xref>, the generalized Maxwell model consists of several Maxwell elements arranged in parallel with an additional spring to capture relaxation behavior. Under constant applied strain, the stress response of a basic Maxwell element can be expressed as<sup><xref rid="CR39" ref-type="bibr">39</xref></sup>:</p><disp-formula id="Equ1"><label>1</label><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e364" display="block"><mml:mrow><mml:mi>σ</mml:mi><mml:mo>(</mml:mo><mml:mi>t</mml:mi><mml:mo>)</mml:mo><mml:mo>=</mml:mo><mml:msub><mml:mrow><mml:mi>ε</mml:mi></mml:mrow><mml:mrow><mml:mn>0</mml:mn></mml:mrow></mml:msub><mml:mi>E</mml:mi><mml:msup><mml:mrow><mml:mi>e</mml:mi></mml:mrow><mml:mrow><mml:mo>−</mml:mo><mml:mfrac><mml:mrow><mml:mi>t</mml:mi></mml:mrow><mml:mrow><mml:mi>τ</mml:mi></mml:mrow></mml:mfrac></mml:mrow></mml:msup></mml:mrow></mml:math></disp-formula><p>Where E is the elastic modulus of the spring, is the applied strain, and <inline-formula id="IEq1"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e392"><mml:mrow><mml:mi mathvariant="normal">τ</mml:mi><mml:mo>=</mml:mo><mml:mfrac><mml:mrow><mml:mi mathvariant="normal">μ</mml:mi></mml:mrow><mml:mrow><mml:mi mathvariant="normal">E</mml:mi></mml:mrow></mml:mfrac></mml:mrow></mml:math></inline-formula> represents the relaxation time constant of the element.</p><fig id="Fig1" position="float"><?disp-level 3?><label>Fig. 1</label><caption><title>Schematic representation of the generalized Maxwell model.</title><p>The model consists of a spring element connected in parallel with multiple Maxwell elements</p></caption><alternatives><graphic xmlns:xlink="http://www.w3.org/1999/xlink" content-type="image" id="d33e413" xlink:href="41378_2026_1342_Fig1_HTML.jpg"><?cloudpmc-path blobs/3fd8/13284314/11a151eb902c/41378_2026_1342_Fig1_HTML.jpg?><?cloudpmc-bucket cdn?><?image-server-status NEVER_LOAD?><?original-height 586?><?original-width 742?><?scaled-height 586?><?scaled-width 742?></graphic><graphic xmlns:xlink="http://www.w3.org/1999/xlink" content-type="thumb" xlink:href="41378_2026_1342_Fig1_HTML.gif"><?cloudpmc-path blobs/3fd8/13284314/d488a8f6fc8c/41378_2026_1342_Fig1_HTML.gif?><?cloudpmc-bucket cdn?></graphic></alternatives></fig><p id="Par10">Since all units connected in parallel undergo the same strain while the total stress is the summation of the stresses carried by each unit, the stress-strain relationship of the generalized Maxwell model can be expressed as follows:</p><disp-formula id="Equ2"><label>2</label><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e420" display="block"><mml:mtable><mml:mtr><mml:mtd columnalign="center"/><mml:mtd columnalign="center"><mml:mi>σ</mml:mi><mml:mo>=</mml:mo><mml:msub><mml:mrow><mml:mi>σ</mml:mi></mml:mrow><mml:mrow><mml:mn>1</mml:mn></mml:mrow></mml:msub><mml:mo>+</mml:mo><mml:msub><mml:mrow><mml:mi>σ</mml:mi></mml:mrow><mml:mrow><mml:mn>2</mml:mn></mml:mrow></mml:msub><mml:mo>+</mml:mo><mml:mo>…</mml:mo><mml:mo>…</mml:mo><mml:mo>+</mml:mo><mml:msub><mml:mrow><mml:mi>σ</mml:mi></mml:mrow><mml:mrow><mml:mi>n</mml:mi></mml:mrow></mml:msub></mml:mtd></mml:mtr><mml:mtr><mml:mtd columnalign="center"/><mml:mtd columnalign="center"><mml:mi>ε</mml:mi><mml:mo>=</mml:mo><mml:msub><mml:mrow><mml:mi>ε</mml:mi></mml:mrow><mml:mrow><mml:mn>1</mml:mn></mml:mrow></mml:msub><mml:mo>=</mml:mo><mml:msub><mml:mrow><mml:mi>ε</mml:mi></mml:mrow><mml:mrow><mml:mn>2</mml:mn></mml:mrow></mml:msub><mml:mo>=</mml:mo><mml:mo>…</mml:mo><mml:mo>…</mml:mo><mml:mo>=</mml:mo><mml:msub><mml:mrow><mml:mi>ε</mml:mi></mml:mrow><mml:mrow><mml:mi>n</mml:mi></mml:mrow></mml:msub></mml:mtd></mml:mtr></mml:mtable></mml:math></disp-formula><p id="Par11">The governing differential equation for the i-th Maxwell element can be expressed as:</p><disp-formula id="Equ3"><label>3</label><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e479" display="block"><mml:mrow><mml:mfrac><mml:mrow><mml:mi>d</mml:mi><mml:mi>ε</mml:mi></mml:mrow><mml:mrow><mml:mi mathvariant="italic">dt</mml:mi></mml:mrow></mml:mfrac><mml:mo>=</mml:mo><mml:mfrac><mml:mrow><mml:mn>1</mml:mn></mml:mrow><mml:mrow><mml:msub><mml:mrow><mml:mi>E</mml:mi></mml:mrow><mml:mrow><mml:mi>i</mml:mi></mml:mrow></mml:msub></mml:mrow></mml:mfrac><mml:mfrac><mml:mrow><mml:mi>d</mml:mi><mml:msub><mml:mrow><mml:mi>σ</mml:mi></mml:mrow><mml:mrow><mml:mi>i</mml:mi></mml:mrow></mml:msub></mml:mrow><mml:mrow><mml:mi mathvariant="italic">dt</mml:mi></mml:mrow></mml:mfrac><mml:mo>+</mml:mo><mml:mfrac><mml:mrow><mml:msub><mml:mrow><mml:mi>σ</mml:mi></mml:mrow><mml:mrow><mml:mi>i</mml:mi></mml:mrow></mml:msub></mml:mrow><mml:mrow><mml:msub><mml:mrow><mml:mi>η</mml:mi></mml:mrow><mml:mrow><mml:mi>i</mml:mi></mml:mrow></mml:msub></mml:mrow></mml:mfrac></mml:mrow></mml:math></disp-formula><p id="Par12">The stress relaxation modulus can be expressed as:</p><disp-formula id="Equ4"><label>4</label><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e530" display="block"><mml:mrow><mml:mi>E</mml:mi><mml:mo>(</mml:mo><mml:mi>t</mml:mi><mml:mo>)</mml:mo><mml:mo>=</mml:mo><mml:msub><mml:mrow><mml:mi>E</mml:mi></mml:mrow><mml:mrow><mml:mi>∞</mml:mi></mml:mrow></mml:msub><mml:mo>+</mml:mo><mml:munderover><mml:mo>∑</mml:mo><mml:mrow><mml:mi>i</mml:mi><mml:mo>=</mml:mo><mml:mn>1</mml:mn></mml:mrow><mml:mrow><mml:mi>N</mml:mi></mml:mrow></mml:munderover><mml:mrow><mml:mspace width="0.25em"/></mml:mrow><mml:msub><mml:mrow><mml:mi>E</mml:mi></mml:mrow><mml:mrow><mml:mi>i</mml:mi></mml:mrow></mml:msub><mml:mo>⋅</mml:mo><mml:msup><mml:mrow><mml:mi>e</mml:mi></mml:mrow><mml:mrow><mml:mo>−</mml:mo><mml:mfrac><mml:mrow><mml:mi>t</mml:mi></mml:mrow><mml:mrow><mml:msub><mml:mrow><mml:mi>τ</mml:mi></mml:mrow><mml:mrow><mml:mi>i</mml:mi></mml:mrow></mml:msub></mml:mrow></mml:mfrac></mml:mrow></mml:msup></mml:mrow></mml:math></disp-formula><p>Where <inline-formula id="IEq2"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e579"><mml:mrow><mml:mi>E</mml:mi><mml:mo>(</mml:mo><mml:mi>t</mml:mi><mml:mo>)</mml:mo></mml:mrow></mml:math></inline-formula> denotes the relaxation modulus of the generalized Maxwell model; <italic>E</italic><sub>∞</sub> is the long term modulus and <inline-formula id="IEq3"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e594"><mml:msub><mml:mrow><mml:mi>E</mml:mi></mml:mrow><mml:mrow><mml:mi>i</mml:mi></mml:mrow></mml:msub></mml:math></inline-formula> represents the i-th Maxwell element. The normalized modulus <inline-formula id="IEq4"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e605"><mml:msub><mml:mrow><mml:mi>g</mml:mi></mml:mrow><mml:mrow><mml:mi>i</mml:mi></mml:mrow></mml:msub></mml:math></inline-formula> is frequently employed as a dimensionless descriptor of material constants, and together with the relaxation time <inline-formula id="IEq5"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e617"><mml:msub><mml:mrow><mml:mi>τ</mml:mi></mml:mrow><mml:mrow><mml:mi>i</mml:mi></mml:mrow></mml:msub></mml:math></inline-formula> constitutes the Prony series, which is widely used for defining viscoelastic properties and for numerical implementation. The expression for <inline-formula id="IEq6"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e628"><mml:msub><mml:mrow><mml:mi>g</mml:mi></mml:mrow><mml:mrow><mml:mi>i</mml:mi></mml:mrow></mml:msub></mml:math></inline-formula> is given by:</p><disp-formula id="Equ5"><label>5</label><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e640" display="block"><mml:mrow><mml:mi>g</mml:mi><mml:mo>(</mml:mo><mml:mi>t</mml:mi><mml:mo>)</mml:mo><mml:mo>=</mml:mo><mml:mn>1</mml:mn><mml:mo>−</mml:mo><mml:munderover><mml:mo>∑</mml:mo><mml:mrow><mml:mi>i</mml:mi><mml:mo>=</mml:mo><mml:mn>1</mml:mn></mml:mrow><mml:mrow><mml:mi>N</mml:mi></mml:mrow></mml:munderover><mml:mrow><mml:mspace width="0.25em"/></mml:mrow><mml:msub><mml:mrow><mml:mi>g</mml:mi></mml:mrow><mml:mrow><mml:mi>i</mml:mi></mml:mrow></mml:msub><mml:mrow><mml:mfenced close=")" open="("><mml:mrow><mml:mn>1</mml:mn><mml:mo>−</mml:mo><mml:msup><mml:mrow><mml:mi>e</mml:mi></mml:mrow><mml:mrow><mml:mo>−</mml:mo><mml:mfrac><mml:mrow><mml:mi>t</mml:mi></mml:mrow><mml:mrow><mml:msub><mml:mrow><mml:mi>τ</mml:mi></mml:mrow><mml:mrow><mml:mi>i</mml:mi></mml:mrow></mml:msub></mml:mrow></mml:mfrac></mml:mrow></mml:msup></mml:mrow></mml:mfenced></mml:mrow></mml:mrow></mml:math></disp-formula><p id="Par13">According to the Boltzmann superposition principle, the stress response of the generalized Maxwell model can be expressed as:</p><disp-formula id="Equ6"><label>6</label><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e690" display="block"><mml:mrow><mml:mi mathvariant="normal">σ</mml:mi><mml:mo>(</mml:mo><mml:mi mathvariant="normal">t</mml:mi><mml:mo>)</mml:mo><mml:mo>=</mml:mo><mml:msub><mml:mrow><mml:mi mathvariant="normal">ε</mml:mi></mml:mrow><mml:mrow><mml:mn>0</mml:mn></mml:mrow></mml:msub><mml:mi mathvariant="normal">E</mml:mi><mml:mo>(</mml:mo><mml:mi mathvariant="normal">t</mml:mi><mml:mo>)</mml:mo><mml:mo>+</mml:mo><mml:msubsup><mml:mrow><mml:mo>∫</mml:mo></mml:mrow><mml:mrow><mml:mn>0</mml:mn></mml:mrow><mml:mrow><mml:mi mathvariant="normal">t</mml:mi></mml:mrow></mml:msubsup><mml:mrow><mml:mspace width="0.25em"/></mml:mrow><mml:mi mathvariant="normal">E</mml:mi><mml:mo>(</mml:mo><mml:mi mathvariant="normal">t</mml:mi><mml:mo>−</mml:mo><mml:mi mathvariant="normal">ξ</mml:mi><mml:mo>)</mml:mo><mml:mfrac><mml:mrow><mml:mi mathvariant="normal">d</mml:mi><mml:mi mathvariant="normal">ε</mml:mi><mml:mo>(</mml:mo><mml:mi mathvariant="normal">ξ</mml:mi><mml:mo>)</mml:mo></mml:mrow><mml:mrow><mml:mi mathvariant="normal">d</mml:mi><mml:mi mathvariant="normal">ξ</mml:mi></mml:mrow></mml:mfrac><mml:mi mathvariant="normal">d</mml:mi><mml:mi mathvariant="normal">ξ</mml:mi></mml:mrow></mml:math></disp-formula><p id="Par14">In the subsequent experiments, OCA will be subjected to stress-relaxation and dynamic viscoelastic tests, and the resulting data will be interpreted using the generalized Maxwell framework to identify the parameters pertinent to the viscoelastic constitutive model.</p></sec><sec id="Sec4" disp-level="2"><title>Viscoplastic Constitutive Model</title><p id="Par15">In this study, we adopt the Qian-Liu model to characterize the viscoplastic behavior of OCA. As a damage-coupled unified viscoplastic constitutive framework grounded in irreversible thermodynamics, it enables the coupling of elastic and viscoplastic damage and effectively captures time- and rate-dependent viscoplastic deformation, complex loading histories, and creep-fatigue interactions; it is therefore well suited for describing the viscoplastic response of OCA<sup><xref rid="CR17" ref-type="bibr">17</xref>,<xref rid="CR40" ref-type="bibr">40</xref>,<xref rid="CR41" ref-type="bibr">41</xref></sup>.</p><p id="Par16">The general form of the Qian-Liu viscoplastic model is given by<sup><xref rid="CR17" ref-type="bibr">17</xref></sup>:</p><disp-formula id="Equ7"><label>7</label><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e778" display="block"><mml:mrow><mml:msubsup><mml:mrow><mml:mover accent="true"><mml:mrow><mml:mi>ε</mml:mi></mml:mrow><mml:mo>˙</mml:mo></mml:mover></mml:mrow><mml:mrow><mml:mi mathvariant="normal">ss</mml:mi></mml:mrow><mml:mrow><mml:mi mathvariant="normal">Ι</mml:mi></mml:mrow></mml:msubsup><mml:mo>=</mml:mo><mml:mi mathvariant="normal">Θ</mml:mi><mml:mo>(</mml:mo><mml:mi>T</mml:mi><mml:mo>)</mml:mo><mml:msup><mml:mrow><mml:mfenced close="]" open="["><mml:mrow><mml:mi>sinh</mml:mi><mml:mrow><mml:mfenced close=")" open="("><mml:mrow><mml:mi>A</mml:mi><mml:msub><mml:mrow><mml:mi>σ</mml:mi></mml:mrow><mml:mrow><mml:mi mathvariant="italic">ss</mml:mi></mml:mrow></mml:msub></mml:mrow></mml:mfenced></mml:mrow></mml:mrow></mml:mfenced></mml:mrow><mml:mrow><mml:mi>n</mml:mi></mml:mrow></mml:msup></mml:mrow></mml:math></disp-formula><disp-formula id="Equ8"><label>8</label><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e820" display="block"><mml:mrow><mml:msup><mml:mrow><mml:mover accent="true"><mml:mrow><mml:mi>ε</mml:mi></mml:mrow><mml:mo>˙</mml:mo></mml:mover></mml:mrow><mml:mrow><mml:mi mathvariant="normal">Ι</mml:mi></mml:mrow></mml:msup><mml:mo>=</mml:mo><mml:mi mathvariant="normal">Θ</mml:mi><mml:mo>(</mml:mo><mml:mi>T</mml:mi><mml:mo>)</mml:mo><mml:msup><mml:mrow><mml:mfenced close="]" open="["><mml:mrow><mml:mi>sinh</mml:mi><mml:mrow><mml:mfenced close=")" open="("><mml:mrow><mml:mfrac><mml:mrow><mml:mi>σ</mml:mi><mml:mo>−</mml:mo><mml:msub><mml:mrow><mml:mi>X</mml:mi></mml:mrow><mml:mrow><mml:mn>1</mml:mn></mml:mrow></mml:msub><mml:mo>−</mml:mo><mml:msub><mml:mrow><mml:mi>X</mml:mi></mml:mrow><mml:mrow><mml:mn>2</mml:mn></mml:mrow></mml:msub></mml:mrow><mml:mrow><mml:mi>D</mml:mi></mml:mrow></mml:mfrac></mml:mrow></mml:mfenced></mml:mrow></mml:mrow></mml:mfenced></mml:mrow><mml:mrow><mml:mi>n</mml:mi></mml:mrow></mml:msup></mml:mrow></mml:math></disp-formula><disp-formula id="Equ9"><label>9</label><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e869" display="block"><mml:mrow><mml:msub><mml:mrow><mml:mi>X</mml:mi></mml:mrow><mml:mrow><mml:mn>1</mml:mn></mml:mrow></mml:msub><mml:mo>=</mml:mo><mml:mfrac><mml:mrow><mml:mi>A</mml:mi><mml:msub><mml:mrow><mml:mi>σ</mml:mi></mml:mrow><mml:mrow><mml:mi mathvariant="italic">ss</mml:mi></mml:mrow></mml:msub></mml:mrow><mml:mrow><mml:msub><mml:mrow><mml:mi>A</mml:mi></mml:mrow><mml:mrow><mml:mn>1</mml:mn></mml:mrow></mml:msub></mml:mrow></mml:mfrac><mml:mrow><mml:mfenced close="]" open="["><mml:mrow><mml:mn>1</mml:mn><mml:mo>−</mml:mo><mml:mi>exp</mml:mi><mml:mrow><mml:mfenced close=")" open="("><mml:mrow><mml:mo>−</mml:mo><mml:mfrac><mml:mrow><mml:msub><mml:mrow><mml:mi>A</mml:mi></mml:mrow><mml:mrow><mml:mn>1</mml:mn></mml:mrow></mml:msub><mml:msub><mml:mrow><mml:mi>H</mml:mi></mml:mrow><mml:mrow><mml:mn>1</mml:mn></mml:mrow></mml:msub></mml:mrow><mml:mrow><mml:mi>A</mml:mi><mml:msub><mml:mrow><mml:mi>σ</mml:mi></mml:mrow><mml:mrow><mml:mi mathvariant="italic">ss</mml:mi></mml:mrow></mml:msub></mml:mrow></mml:mfrac><mml:msup><mml:mrow><mml:mi>ε</mml:mi></mml:mrow><mml:mrow><mml:mi mathvariant="normal">Ι</mml:mi></mml:mrow></mml:msup></mml:mrow></mml:mfenced></mml:mrow></mml:mrow></mml:mfenced></mml:mrow></mml:mrow></mml:math></disp-formula><disp-formula id="Equ10"><label>10</label><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e933" display="block"><mml:mrow><mml:msub><mml:mrow><mml:mi mathvariant="normal">X</mml:mi></mml:mrow><mml:mrow><mml:mn>2</mml:mn></mml:mrow></mml:msub><mml:mo>=</mml:mo><mml:mfrac><mml:mrow><mml:mi>A</mml:mi><mml:msub><mml:mrow><mml:mi mathvariant="normal">σ</mml:mi></mml:mrow><mml:mrow><mml:mi mathvariant="normal">ss</mml:mi></mml:mrow></mml:msub></mml:mrow><mml:mrow><mml:msub><mml:mrow><mml:mi>A</mml:mi></mml:mrow><mml:mrow><mml:mn>2</mml:mn></mml:mrow></mml:msub></mml:mrow></mml:mfrac><mml:mrow><mml:mfenced close="]" open="["><mml:mrow><mml:mn>1</mml:mn><mml:mo>−</mml:mo><mml:mi>exp</mml:mi><mml:mrow><mml:mfenced close=")" open="("><mml:mrow><mml:mo>−</mml:mo><mml:mfrac><mml:mrow><mml:msub><mml:mrow><mml:mi>A</mml:mi></mml:mrow><mml:mrow><mml:mn>2</mml:mn></mml:mrow></mml:msub><mml:msub><mml:mrow><mml:mi mathvariant="normal">H</mml:mi></mml:mrow><mml:mrow><mml:mn>2</mml:mn></mml:mrow></mml:msub></mml:mrow><mml:mrow><mml:mi>A</mml:mi><mml:msub><mml:mrow><mml:mi>σ</mml:mi></mml:mrow><mml:mrow><mml:mi mathvariant="italic">ss</mml:mi></mml:mrow></mml:msub></mml:mrow></mml:mfrac><mml:msup><mml:mrow><mml:mi mathvariant="normal">ε</mml:mi></mml:mrow><mml:mrow><mml:mi mathvariant="normal">Ι</mml:mi></mml:mrow></mml:msup></mml:mrow></mml:mfenced></mml:mrow></mml:mrow></mml:mfenced></mml:mrow></mml:mrow></mml:math></disp-formula><p>Where <inline-formula id="IEq7"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e1001"><mml:mrow><mml:mi mathvariant="normal">Θ</mml:mi><mml:mo>(</mml:mo><mml:mi>T</mml:mi><mml:mo>)</mml:mo></mml:mrow></mml:math></inline-formula> denotes the thermal activation term, whose explicit expression is:</p><disp-formula id="Equ11"><label>11</label><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e1014" display="block"><mml:mrow><mml:mi mathvariant="normal">Θ</mml:mi><mml:mo>(</mml:mo><mml:mi>T</mml:mi><mml:mo>)</mml:mo><mml:mo>=</mml:mo><mml:msub><mml:mrow><mml:mover accent="true"><mml:mrow><mml:mi>ε</mml:mi></mml:mrow><mml:mo>˙</mml:mo></mml:mover></mml:mrow><mml:mrow><mml:mn>0</mml:mn></mml:mrow></mml:msub><mml:mi>exp</mml:mi><mml:mrow><mml:mfenced close=")" open="("><mml:mrow><mml:mo>−</mml:mo><mml:mfrac><mml:mrow><mml:mi>Q</mml:mi></mml:mrow><mml:mrow><mml:mi mathvariant="italic">kT</mml:mi></mml:mrow></mml:mfrac></mml:mrow></mml:mfenced></mml:mrow></mml:mrow></mml:math></disp-formula><p id="Par17">In the formulation, the back stresses <inline-formula id="IEq8"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e1047"><mml:msub><mml:mrow><mml:mi>X</mml:mi></mml:mrow><mml:mrow><mml:mn>1</mml:mn></mml:mrow></mml:msub></mml:math></inline-formula> and <inline-formula id="IEq9"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e1058"><mml:msub><mml:mrow><mml:mi mathvariant="normal">X</mml:mi></mml:mrow><mml:mrow><mml:mn>2</mml:mn></mml:mrow></mml:msub></mml:math></inline-formula> are introduced to capture the short and long-range components of dislocation-mediated internal stress;<inline-formula id="IEq10"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e1070"><mml:msup><mml:mrow><mml:mover accent="true"><mml:mrow><mml:mi>ε</mml:mi></mml:mrow><mml:mo>˙</mml:mo></mml:mover></mml:mrow><mml:mrow><mml:mi mathvariant="normal">Ι</mml:mi></mml:mrow></mml:msup></mml:math></inline-formula> and <inline-formula id="IEq11"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e1085"><mml:msup><mml:mrow><mml:mi>ε</mml:mi></mml:mrow><mml:mrow><mml:mi mathvariant="normal">Ι</mml:mi></mml:mrow></mml:msup></mml:math></inline-formula> denote the inelastic strain rate and inelastic strain, respectively;Q is the apparent activation energy;T the absolute temperature;G the shear modulus; D the drag stress; <inline-formula id="IEq12"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e1097"><mml:msub><mml:mrow><mml:mi>σ</mml:mi></mml:mrow><mml:mrow><mml:mi mathvariant="italic">ss</mml:mi></mml:mrow></mml:msub></mml:math></inline-formula> the saturation stress; <inline-formula id="IEq13"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e1110"><mml:msub><mml:mrow><mml:mi mathvariant="normal">H</mml:mi></mml:mrow><mml:mrow><mml:mn>1</mml:mn></mml:mrow></mml:msub></mml:math></inline-formula> and <inline-formula id="IEq14"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e1122"><mml:msub><mml:mrow><mml:mi mathvariant="normal">H</mml:mi></mml:mrow><mml:mrow><mml:mn>2</mml:mn></mml:mrow></mml:msub></mml:math></inline-formula> are the strain-hardening coefficients, and these parameters will change with temperature, affecting the strain; and <italic>A</italic>, <italic>A</italic><sub>1</sub>, <italic>A</italic><sub>2</sub> are the back-stress coefficients. The Qian-Liu model conforms to the canonical Garofalo-Arrhenius form and employs two back-stress components to represent short and long-range internal stress effects, thereby providing a micromechanically grounded (dislocation-based) explanation of how temperature and strain rate govern the material’s mechanical response.</p><p id="Par18">Given the rapid stress saturation under tensile loading, the plastic strain rates in Eqs. (<xref rid="Equ7" ref-type="disp-formula">7</xref>) and (<xref rid="Equ8" ref-type="disp-formula">8</xref>) can be regarded as equivalent, yielding the following expression:</p><disp-formula id="Equ12"><label>12</label><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e1154" display="block"><mml:mrow><mml:mi mathvariant="normal">σ</mml:mi><mml:mo>=</mml:mo><mml:mi mathvariant="normal">Darcsinh</mml:mi><mml:msup><mml:mrow><mml:mfenced close="]" open="["><mml:mrow><mml:mfrac><mml:mrow><mml:msubsup><mml:mrow><mml:mover accent="true"><mml:mrow><mml:mi>ε</mml:mi></mml:mrow><mml:mo>˙</mml:mo></mml:mover></mml:mrow><mml:mrow><mml:mi mathvariant="normal">ss</mml:mi></mml:mrow><mml:mrow><mml:mi mathvariant="normal">Ι</mml:mi></mml:mrow></mml:msubsup></mml:mrow><mml:mrow><mml:mi mathvariant="normal">Θ</mml:mi><mml:mo>(</mml:mo><mml:mi mathvariant="normal">T</mml:mi><mml:mo>)</mml:mo></mml:mrow></mml:mfrac></mml:mrow></mml:mfenced></mml:mrow><mml:mrow><mml:mfrac><mml:mrow><mml:mn>1</mml:mn></mml:mrow><mml:mrow><mml:mi mathvariant="normal">n</mml:mi></mml:mrow></mml:mfrac></mml:mrow></mml:msup><mml:mo>+</mml:mo><mml:msub><mml:mrow><mml:mi mathvariant="normal">X</mml:mi></mml:mrow><mml:mrow><mml:mn>1</mml:mn></mml:mrow></mml:msub><mml:mo>+</mml:mo><mml:msub><mml:mrow><mml:mi mathvariant="normal">X</mml:mi></mml:mrow><mml:mrow><mml:mn>2</mml:mn></mml:mrow></mml:msub></mml:mrow></mml:math></disp-formula><p id="Par19">For comparison, He et al. proposed a modified Qian-Liu formulation by introducing an additional temperature-dependent hardening stress term, which improves the description of temperature-dependent behavior. The modified expression can be written as:</p><disp-formula id="Equ13"><label>13</label><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e1214" display="block"><mml:mrow><mml:mi mathvariant="normal">σ</mml:mi><mml:mo>=</mml:mo><mml:mi mathvariant="normal">Darcsinh</mml:mi><mml:msup><mml:mrow><mml:mfenced close="]" open="["><mml:mrow><mml:mfrac><mml:mrow><mml:msubsup><mml:mrow><mml:mover accent="true"><mml:mrow><mml:mi>ε</mml:mi></mml:mrow><mml:mo>˙</mml:mo></mml:mover></mml:mrow><mml:mrow><mml:mi mathvariant="normal">ss</mml:mi></mml:mrow><mml:mrow><mml:mi mathvariant="normal">Ι</mml:mi></mml:mrow></mml:msubsup></mml:mrow><mml:mrow><mml:mi mathvariant="normal">Θ</mml:mi><mml:mo>(</mml:mo><mml:mi mathvariant="normal">T</mml:mi><mml:mo>)</mml:mo></mml:mrow></mml:mfrac></mml:mrow></mml:mfenced></mml:mrow><mml:mrow><mml:mfrac><mml:mrow><mml:mn>1</mml:mn></mml:mrow><mml:mrow><mml:mi mathvariant="normal">n</mml:mi></mml:mrow></mml:mfrac></mml:mrow></mml:msup><mml:mo>+</mml:mo><mml:msub><mml:mrow><mml:mi mathvariant="normal">X</mml:mi></mml:mrow><mml:mrow><mml:mn>1</mml:mn></mml:mrow></mml:msub><mml:mo>+</mml:mo><mml:msub><mml:mrow><mml:mi mathvariant="normal">X</mml:mi></mml:mrow><mml:mrow><mml:mn>2</mml:mn></mml:mrow></mml:msub><mml:mo>+</mml:mo><mml:msub><mml:mrow><mml:mi mathvariant="normal">σ</mml:mi></mml:mrow><mml:mrow><mml:mi mathvariant="normal">H</mml:mi></mml:mrow></mml:msub><mml:mo>(</mml:mo><mml:mi mathvariant="normal">T</mml:mi><mml:mo>)</mml:mo></mml:mrow></mml:math></disp-formula><p id="Par20">To facilitate subsequent parameter identification, we derive the differential form of the Qian-Liu model and obtain the time-dependent relation for its tangent modulus.</p><p id="Par21">Starting from:</p><disp-formula id="Equ14"><label>14</label><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e1289" display="block"><mml:mrow><mml:mi mathvariant="normal">σ</mml:mi><mml:mo>=</mml:mo><mml:mi mathvariant="normal">E</mml:mi><mml:msup><mml:mrow><mml:mi>ε</mml:mi></mml:mrow><mml:mrow><mml:mi mathvariant="normal">Ι</mml:mi></mml:mrow></mml:msup></mml:mrow></mml:math></disp-formula><p id="Par22">Differentiating both sides of Eq.n (<xref rid="Equ13" ref-type="disp-formula">13</xref>) with respect to time yields:</p><disp-formula id="Equ15"><label>15</label><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e1312" display="block"><mml:mrow><mml:mfrac><mml:mrow><mml:mi mathvariant="normal">d</mml:mi><mml:mi mathvariant="normal">σ</mml:mi></mml:mrow><mml:mrow><mml:mi mathvariant="normal">dt</mml:mi></mml:mrow></mml:mfrac><mml:mo>=</mml:mo><mml:mfrac><mml:mrow><mml:mi mathvariant="normal">dE</mml:mi></mml:mrow><mml:mrow><mml:mi mathvariant="normal">dt</mml:mi></mml:mrow></mml:mfrac><mml:msup><mml:mrow><mml:mi>ε</mml:mi></mml:mrow><mml:mrow><mml:mi mathvariant="normal">Ι</mml:mi></mml:mrow></mml:msup><mml:mo>+</mml:mo><mml:mi mathvariant="normal">E</mml:mi><mml:mo>(</mml:mo><mml:mi mathvariant="normal">t</mml:mi><mml:mo>)</mml:mo><mml:mfrac><mml:mrow><mml:mi mathvariant="normal">d</mml:mi><mml:msup><mml:mrow><mml:mi>ε</mml:mi></mml:mrow><mml:mrow><mml:mi mathvariant="normal">Ι</mml:mi></mml:mrow></mml:msup></mml:mrow><mml:mrow><mml:mi mathvariant="normal">dt</mml:mi></mml:mrow></mml:mfrac></mml:mrow></mml:math></disp-formula><p id="Par23">Here, we simplify the model by assuming that:</p><disp-formula id="Equ16"><label>16</label><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e1364" display="block"><mml:mrow><mml:msup><mml:mrow><mml:mi>ε</mml:mi></mml:mrow><mml:mrow><mml:mi mathvariant="normal">Ι</mml:mi></mml:mrow></mml:msup><mml:mo>=</mml:mo><mml:mi mathvariant="normal">kt</mml:mi></mml:mrow></mml:math></disp-formula><p>Where kdenotes the strain rate. This assumption is based on the steady-state creep behavior, where the plastic strain rate becomes constant after the initial transient phase.</p><p id="Par24">By substituting Eqs. (<xref rid="Equ12" ref-type="disp-formula">12</xref>) and (<xref rid="Equ15" ref-type="disp-formula">15</xref>) into Eq. (<xref rid="Equ14" ref-type="disp-formula">14</xref>) and integrating both sides, the time-dependent relation for the tangent modulus of the Qian-Liu model is obtained as:</p><disp-formula id="Equ17"><label>17</label><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e1392" display="block"><mml:mrow><mml:mi mathvariant="normal">E</mml:mi><mml:mo>(</mml:mo><mml:mi mathvariant="normal">t</mml:mi><mml:mo>)</mml:mo><mml:mo>=</mml:mo><mml:mfrac><mml:mrow><mml:mi>A</mml:mi><mml:msub><mml:mrow><mml:mi>σ</mml:mi></mml:mrow><mml:mrow><mml:mi mathvariant="italic">ss</mml:mi></mml:mrow></mml:msub></mml:mrow><mml:mrow><mml:mi mathvariant="normal">kt</mml:mi></mml:mrow></mml:mfrac><mml:mrow><mml:mfenced close=")" open="("><mml:mrow><mml:mfrac><mml:mrow><mml:mn>1</mml:mn><mml:mo>−</mml:mo><mml:msup><mml:mrow><mml:mi mathvariant="normal">e</mml:mi></mml:mrow><mml:mrow><mml:mo>−</mml:mo><mml:mfrac><mml:mrow><mml:msub><mml:mrow><mml:mi>A</mml:mi></mml:mrow><mml:mrow><mml:mn>1</mml:mn></mml:mrow></mml:msub><mml:msub><mml:mrow><mml:mi mathvariant="normal">H</mml:mi></mml:mrow><mml:mrow><mml:mn>1</mml:mn></mml:mrow></mml:msub><mml:mi mathvariant="normal">k</mml:mi></mml:mrow><mml:mrow><mml:mi>A</mml:mi><mml:msub><mml:mrow><mml:mi>σ</mml:mi></mml:mrow><mml:mrow><mml:mi mathvariant="italic">ss</mml:mi></mml:mrow></mml:msub></mml:mrow></mml:mfrac><mml:mi mathvariant="normal">t</mml:mi></mml:mrow></mml:msup></mml:mrow><mml:mrow><mml:msub><mml:mrow><mml:mi>A</mml:mi></mml:mrow><mml:mrow><mml:mn>1</mml:mn></mml:mrow></mml:msub></mml:mrow></mml:mfrac><mml:mo>+</mml:mo><mml:mfrac><mml:mrow><mml:mn>1</mml:mn><mml:mo>−</mml:mo><mml:msup><mml:mrow><mml:mi mathvariant="normal">e</mml:mi></mml:mrow><mml:mrow><mml:mo>−</mml:mo><mml:mfrac><mml:mrow><mml:msub><mml:mrow><mml:mi>A</mml:mi></mml:mrow><mml:mrow><mml:mn>2</mml:mn></mml:mrow></mml:msub><mml:msub><mml:mrow><mml:mi mathvariant="normal">H</mml:mi></mml:mrow><mml:mrow><mml:mn>2</mml:mn></mml:mrow></mml:msub><mml:mi mathvariant="normal">k</mml:mi></mml:mrow><mml:mrow><mml:mi>A</mml:mi><mml:msub><mml:mrow><mml:mi>σ</mml:mi></mml:mrow><mml:mrow><mml:mi mathvariant="italic">ss</mml:mi></mml:mrow></mml:msub></mml:mrow></mml:mfrac><mml:mi mathvariant="normal">t</mml:mi></mml:mrow></mml:msup></mml:mrow><mml:mrow><mml:msub><mml:mrow><mml:mi>A</mml:mi></mml:mrow><mml:mrow><mml:mn>2</mml:mn></mml:mrow></mml:msub></mml:mrow></mml:mfrac></mml:mrow></mml:mfenced></mml:mrow></mml:mrow></mml:math></disp-formula></sec><sec id="Sec5" disp-level="2"><title>Viscoelastic-Viscoplastic Constitutive Model</title><p id="Par25">In this study, the total strain is decomposed into viscoelastic and viscoplastic components, which are assumed to be uncoupled<sup><xref rid="CR35" ref-type="bibr">35</xref>,<xref rid="CR42" ref-type="bibr">42</xref></sup>:</p><disp-formula id="Equ18"><label>18</label><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e1515" display="block"><mml:mrow><mml:msup><mml:mrow><mml:mi mathvariant="normal">ε</mml:mi></mml:mrow><mml:mrow><mml:mi mathvariant="normal">total</mml:mi></mml:mrow></mml:msup><mml:mo>=</mml:mo><mml:msup><mml:mrow><mml:mi mathvariant="normal">ε</mml:mi></mml:mrow><mml:mrow><mml:mi mathvariant="normal">ve</mml:mi></mml:mrow></mml:msup><mml:mo>+</mml:mo><mml:msup><mml:mrow><mml:mi mathvariant="normal">ε</mml:mi></mml:mrow><mml:mrow><mml:mi mathvariant="normal">vp</mml:mi></mml:mrow></mml:msup></mml:mrow></mml:math></disp-formula><p>where the superscripts total, ve, and vp denote the total strain and the viscoelastic and viscoplastic strain components, respectively. By multiplying Eqs. (<xref rid="Equ4" ref-type="disp-formula">4</xref>) and (<xref rid="Equ16" ref-type="disp-formula">16</xref>) by their corresponding strains and then summing, the viscoelastic-viscoplastic constitutive relation for OCA is obtained.</p><disp-formula id="Equ19"><label>19</label><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e1552" display="block"><mml:mrow><mml:mi mathvariant="normal">σ</mml:mi><mml:mo>(</mml:mo><mml:mi mathvariant="normal">t</mml:mi><mml:mo>)</mml:mo><mml:mo>=</mml:mo><mml:mrow><mml:mfenced close="]" open="["><mml:mrow><mml:msub><mml:mrow><mml:mi mathvariant="normal">E</mml:mi></mml:mrow><mml:mrow><mml:mi>∞</mml:mi></mml:mrow></mml:msub><mml:mo>+</mml:mo><mml:munderover><mml:mo>∑</mml:mo><mml:mrow><mml:mi mathvariant="normal">i</mml:mi><mml:mo>=</mml:mo><mml:mn>1</mml:mn></mml:mrow><mml:mrow><mml:mi mathvariant="normal">N</mml:mi></mml:mrow></mml:munderover><mml:mrow><mml:mspace width="0.25em"/></mml:mrow><mml:mspace width="0.25em"/><mml:msub><mml:mrow><mml:mi mathvariant="normal">E</mml:mi></mml:mrow><mml:mrow><mml:mi mathvariant="normal">i</mml:mi></mml:mrow></mml:msub><mml:msup><mml:mrow><mml:mi mathvariant="normal">e</mml:mi></mml:mrow><mml:mrow><mml:mo>−</mml:mo><mml:mfrac><mml:mrow><mml:mi mathvariant="normal">t</mml:mi></mml:mrow><mml:mrow><mml:msub><mml:mrow><mml:mi mathvariant="normal">τ</mml:mi></mml:mrow><mml:mrow><mml:mi mathvariant="normal">i</mml:mi></mml:mrow></mml:msub></mml:mrow></mml:mfrac></mml:mrow></mml:msup></mml:mrow></mml:mfenced></mml:mrow><mml:msup><mml:mrow><mml:mi mathvariant="normal">ε</mml:mi></mml:mrow><mml:mrow><mml:mi mathvariant="normal">ve</mml:mi></mml:mrow></mml:msup><mml:mo>+</mml:mo><mml:mfrac><mml:mrow><mml:mi>A</mml:mi><mml:msub><mml:mrow><mml:mi>σ</mml:mi></mml:mrow><mml:mrow><mml:mi mathvariant="italic">ss</mml:mi></mml:mrow></mml:msub></mml:mrow><mml:mrow><mml:mi mathvariant="normal">kt</mml:mi></mml:mrow></mml:mfrac><mml:mrow><mml:mfenced close=")" open="("><mml:mrow><mml:mfrac><mml:mrow><mml:mn>1</mml:mn><mml:mo>−</mml:mo><mml:msup><mml:mrow><mml:mi mathvariant="normal">e</mml:mi></mml:mrow><mml:mrow><mml:mo>−</mml:mo><mml:mfrac><mml:mrow><mml:msub><mml:mrow><mml:mi>A</mml:mi></mml:mrow><mml:mrow><mml:mn>1</mml:mn></mml:mrow></mml:msub><mml:msub><mml:mrow><mml:mi mathvariant="normal">H</mml:mi></mml:mrow><mml:mrow><mml:mn>1</mml:mn></mml:mrow></mml:msub><mml:mi mathvariant="normal">k</mml:mi></mml:mrow><mml:mrow><mml:mi>A</mml:mi><mml:msub><mml:mrow><mml:mi>σ</mml:mi></mml:mrow><mml:mrow><mml:mi mathvariant="italic">ss</mml:mi></mml:mrow></mml:msub></mml:mrow></mml:mfrac><mml:mi mathvariant="normal">t</mml:mi></mml:mrow></mml:msup></mml:mrow><mml:mrow><mml:msub><mml:mrow><mml:mi>A</mml:mi></mml:mrow><mml:mrow><mml:mn>1</mml:mn></mml:mrow></mml:msub></mml:mrow></mml:mfrac><mml:mo>+</mml:mo><mml:mfrac><mml:mrow><mml:mn>1</mml:mn><mml:mo>−</mml:mo><mml:msup><mml:mrow><mml:mi mathvariant="normal">e</mml:mi></mml:mrow><mml:mrow><mml:mo>−</mml:mo><mml:mfrac><mml:mrow><mml:msub><mml:mrow><mml:mi>A</mml:mi></mml:mrow><mml:mrow><mml:mn>2</mml:mn></mml:mrow></mml:msub><mml:msub><mml:mrow><mml:mi mathvariant="normal">H</mml:mi></mml:mrow><mml:mrow><mml:mn>2</mml:mn></mml:mrow></mml:msub><mml:mi mathvariant="normal">k</mml:mi></mml:mrow><mml:mrow><mml:mi>A</mml:mi><mml:msub><mml:mrow><mml:mi>σ</mml:mi></mml:mrow><mml:mrow><mml:mi mathvariant="italic">ss</mml:mi></mml:mrow></mml:msub></mml:mrow></mml:mfrac><mml:mi mathvariant="normal">t</mml:mi></mml:mrow></mml:msup></mml:mrow><mml:mrow><mml:msub><mml:mrow><mml:mi>A</mml:mi></mml:mrow><mml:mrow><mml:mn>2</mml:mn></mml:mrow></mml:msub></mml:mrow></mml:mfrac></mml:mrow></mml:mfenced></mml:mrow><mml:msup><mml:mrow><mml:mi mathvariant="normal">ε</mml:mi></mml:mrow><mml:mrow><mml:mi mathvariant="normal">vp</mml:mi></mml:mrow></mml:msup></mml:mrow></mml:math></disp-formula></sec></sec><sec id="Sec6" disp-level="1"><title>Materials and Methods</title><sec id="Sec7" disp-level="2"><title>Specimen Selection</title><p id="Par26">At present, there is no unified standard for the preparation of OCA specimens. Zhang et al. conducted uniaxial tensile tests at a constant tensile rate using specimens with different aspect ratios and found that, at a fixed rate of 100 mm/min and a temperature of 30°C, both the scatter and the trends of the measured data were essentially identical across aspect ratios; the size-induced deviation was within 10%, as shown in Fig. <xref rid="Fig2" ref-type="fig">2(a)</xref>, indicating that the material response is effectively scale-independent<sup><xref rid="CR23" ref-type="bibr">23</xref></sup>. Accordingly, to meet the requirements of the testing apparatus, specimens with dimensions 40 mm×10 mm×1 mm were employed for subsequent experiments.</p><fig id="Fig2" position="float"><?disp-level 3?><label>Fig. 2</label><caption><title>Experimental setup and primary mechanical testing data.</title><p><bold>a</bold> Stress-strain data for specimens with different aspect ratios<sup><xref rid="CR23" ref-type="bibr">23</xref></sup>; <bold>b</bold> stress and <bold>c</bold> relaxation modulus as a function of time from stress-relaxation experiments; <bold>d</bold> specimen maintained in tensile mode during testing</p></caption><alternatives><graphic xmlns:xlink="http://www.w3.org/1999/xlink" content-type="image" id="d33e1759" xlink:href="41378_2026_1342_Fig2_HTML.jpg"><?cloudpmc-path blobs/3fd8/13284314/417799096bf5/41378_2026_1342_Fig2_HTML.jpg?><?cloudpmc-bucket cdn?><?image-server-status NEED_LOADING?><?original-height 1274?><?original-width 1536?><?scaled-height 637?><?scaled-width 768?></graphic><graphic xmlns:xlink="http://www.w3.org/1999/xlink" content-type="thumb" xlink:href="41378_2026_1342_Fig2_HTML.gif"><?cloudpmc-path blobs/3fd8/13284314/d2aed7b9e8d0/41378_2026_1342_Fig2_HTML.gif?><?cloudpmc-bucket cdn?></graphic></alternatives></fig></sec><sec id="Sec8" disp-level="2"><title>Experimental Procedure</title><p id="Par27">Tests of static mechanical behavior were conducted primarily via stress-relaxation and creep experiments, both of which probe the time-dependent response of the material. In stress-relaxation measurements, polymer specimens are subjected to an instantaneous deformation at a prescribed temperature, and the decay of the stress required to maintain the constant strain is recorded; the imposed strain is a step input. Stress-relaxation testing is particularly advantageous for elucidating polymer mechanics from the perspective of molecular mobility. Moreover, temperature exerts a pronounced influence on the mechanical response of OCA—manifested in differences in relaxation times and equilibrium moduli—so examining stress-relaxation behavior over a range of temperatures facilitates a micro-to-macro understanding of its macroscopic mechanical characteristics.</p><p id="Par28">Uniaxial stress-relaxation tests at 30, 60, and 85 °C were conducted on three specimens per group, and dynamic viscoelastic tests were performed on the OCA material; these temperatures were selected to span near-ambient, intermediate, and engineering-relevant high-temperature conditions commonly adopted in optoelectronic reliability assessment. For all three temperatures, the same target tensile strain of 50% was applied and held constant for 10 min, ensuring consistent strain conditions for cross-temperature comparison. The resulting time evolutions of stress and relaxation modulus are presented in Fig. <xref rid="Fig2" ref-type="fig">2b, c</xref> and were subsequently used to identify parameters for the viscoelastic and viscoelastic-viscoplastic constitutive models. Figure <xref rid="Fig2" ref-type="fig">2d</xref> shows the specimen, which remained in tensile mode throughout the experiment.</p><p id="Par29">The dynamic viscoelastic tests were carried out using the DMA Q800, where a 0.01 N preload force and a 125% force track were applied. The force track adjusted the total force to avoid the sample from automatically buckling during the test. The amplitude of the sinusoidal force applied to the samples was set to 20㎛. Dynamic mechanical analysis (DMA) was performed to investigate the temperature-dependent viscoelastic behavior of the OCA material. Temperature sweeps were conducted over a broad range of temperatures, from -40°C to 125°C, with oscillation frequencies selected at 1 Hz, 2 Hz, 5 Hz, and 10 Hz. The temperature was changed at a rate of 3°C per minute, and this range was selected to refer to the J-STD-020D standards. The resulting data were processed to establish the viscoelastic model.</p></sec></sec><sec id="Sec9" disp-level="1"><title>Results and discussions</title><p id="Par30">This section first performs parameter identification from the stress-relaxation data using both a viscoelastic constitutive description and a viscoelastic-viscoplastic counterpart. The viscoelastic response is represented by a generalized Maxwell model, whereas the viscoplastic response is formulated within the Qian-Liu framework via its evolution equations. During fitting, to ensure cross-temperature comparability and numerical stability, the strain-rate parameter was held constant. Material parameters for each model were obtained by nonlinear least-squares regression, followed by a quantitative comparison to assess the suitability and accuracy of the two models in capturing the stress-relaxation behavior. The constitutive models developed in Section 2 were subsequently implemented in ABAQUS via a UMAT user subroutine to construct a finite-element model of a flexible display and conduct numerical simulations, after which the simulation results were validated and analyzed.</p><sec id="Sec10" disp-level="2"><title>Parameter Identification for the Viscoelastic Constitutive Model</title><p id="Par31">To quantitatively identify the temperature-dependent viscoelastic characteristics of OCA, this section calibrates the constitutive parameters using the stress-relaxation and DMA datasets described in Experimental Procedure. Specifically, the relaxation response is mapped to the constitutive formulation through least-squares minimization between the measured and predicted stress histories, from which the viscoelastic and viscoelastic-viscoplastic parameters at 30, 60, and 85 °C are determined.</p><p id="Par32">As shown in Fig. <xref rid="Fig2" ref-type="fig">2b, c</xref>, both the stress and the relaxation modulus rise sharply within a very short time before the target strain is reached; upon entering the relaxation stage, both decrease markedly with time and eventually approach steady values. At 85 °C, the peak stress is approximately 12.65 kPa and rapidly decays to an equilibrium value of 1.84 kPa; correspondingly, the relaxation modulus decreases from 64.80 kPa to 9.51 kPa. These observations underscore the pronounced influence of temperature on viscoelastic behavior: increasing temperature enhances segmental thermal mobility, enlarges the free volume, and reduces intermolecular friction, thereby accelerating stress relaxation and lowering both the equilibrium stress and the equilibrium relaxation modulus. At low temperatures, stress decay is primarily constrained by local segmental motions within the crosslinked network, whereas at elevated temperatures cooperative segmental dynamics and network rearrangement are significantly intensified, leading to a much faster relaxation process.</p><p id="Par33">To establish a constitutive relation suitable for subsequent finite-element analysis, the relaxation responses at each temperature were fitted using a third-order generalized Maxwell model so as to capture viscoelastic features across multiple time scales; goodness of fit was evaluated by the coefficient of determination. As shown in Fig. <xref rid="Fig3" ref-type="fig">3a</xref>, with the corresponding Prony coefficients listed in Table <xref rid="Tab1" ref-type="table">1</xref>, the fitted curves exhibit excellent agreement with the experimental data, with <inline-formula id="IEq15"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e1798"><mml:msup><mml:mrow><mml:mi>R</mml:mi></mml:mrow><mml:mrow><mml:mn>2</mml:mn></mml:mrow></mml:msup></mml:math></inline-formula> values exceeding 0.98, indicating that the model reproduces the stress-relaxation behavior of OCA with high fidelity. The parameter trends show that the three relaxation time constants <inline-formula id="IEq16"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e1809"><mml:mrow><mml:msub><mml:mrow><mml:mi>τ</mml:mi></mml:mrow><mml:mrow><mml:mn>1</mml:mn></mml:mrow></mml:msub><mml:mo>,</mml:mo><mml:msub><mml:mrow><mml:mi>τ</mml:mi></mml:mrow><mml:mrow><mml:mn>2</mml:mn></mml:mrow></mml:msub><mml:mo>,</mml:mo><mml:msub><mml:mrow><mml:mi>τ</mml:mi></mml:mrow><mml:mrow><mml:mn>3</mml:mn></mml:mrow></mml:msub></mml:mrow></mml:math></inline-formula> correspond to fast segmental motion, mesoscale cooperative segmental dynamics, and long-time structural relaxation, respectively. With increasing temperature, all three mechanisms accelerate markedly, leading to pronounced reductions in their characteristic relaxation times <italic>τ</italic><sub><italic>i</italic></sub>. Meanwhile, the modal relaxation modulus <inline-formula id="IEq17"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e1840"><mml:msub><mml:mrow><mml:mi>g</mml:mi></mml:mrow><mml:mrow><mml:mi>i</mml:mi></mml:mrow></mml:msub></mml:math></inline-formula> decrease, reflecting an overall reduction in stiffness across relaxation modes. This trend is consistent with prior findings for acrylate-based structural adhesives and underscores that the temperature sensitivity of OCA’s viscoelasticity is closely linked to polymer chain flexibility.</p><fig id="Fig3" position="float"><?disp-level 3?><label>Fig. 3</label><caption><title>Constitutive model fitting and parameter identification.</title><p><bold>a</bold> Generalized Maxwell model fits at different temperatures; <bold>b</bold> Benchmark: generalized Maxwell fitting results from Ref. <sup><xref rid="CR23" ref-type="bibr">23</xref></sup>; <bold>c</bold> Storage-modulus master curve at the reference temperature of 0 °C; <bold>d</bold> Generalized Maxwell model fit to the master curve; <bold>e</bold> Master-curve shift factors and corresponding WLF/Arrhenius fits; <bold>f</bold> Viscoelastic-viscoplastic constitutive model fits at different temperatures</p></caption><alternatives><graphic xmlns:xlink="http://www.w3.org/1999/xlink" content-type="image" id="d33e1878" xlink:href="41378_2026_1342_Fig3_HTML.jpg"><?cloudpmc-path blobs/3fd8/13284314/327b8559be24/41378_2026_1342_Fig3_HTML.jpg?><?cloudpmc-bucket cdn?><?image-server-status NEED_LOADING?><?original-height 1832?><?original-width 1522?><?scaled-height 916?><?scaled-width 761?></graphic><graphic xmlns:xlink="http://www.w3.org/1999/xlink" content-type="thumb" xlink:href="41378_2026_1342_Fig3_HTML.gif"><?cloudpmc-path blobs/3fd8/13284314/739d5150553d/41378_2026_1342_Fig3_HTML.gif?><?cloudpmc-bucket cdn?></graphic></alternatives></fig><table-wrap id="Tab1" position="float"><?disp-level 3?><label>Table 1</label><caption><p>Comparison of generalized Maxwell Prony coefficients across temperature—this work vs. Ref. <sup><xref rid="CR23" ref-type="bibr">23</xref></sup></p></caption><table frame="hsides" rules="groups"><thead><tr><th colspan="1" rowspan="1">Temperature</th><th colspan="1" rowspan="1">i</th><th colspan="1" rowspan="1"><inline-formula id="IEq18"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e1906"><mml:msub><mml:mrow><mml:mi>g</mml:mi></mml:mrow><mml:mrow><mml:mi>i</mml:mi></mml:mrow></mml:msub></mml:math></inline-formula> in this work</th><th colspan="1" rowspan="1"><inline-formula id="IEq19"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e1919"><mml:msub><mml:mrow><mml:mi>g</mml:mi></mml:mrow><mml:mrow><mml:mi>i</mml:mi></mml:mrow></mml:msub></mml:math></inline-formula> in Ref. <sup><xref rid="CR23" ref-type="bibr">23</xref></sup></th><th colspan="1" rowspan="1"><inline-formula id="IEq20"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e1935"><mml:msub><mml:mrow><mml:mi>τ</mml:mi></mml:mrow><mml:mrow><mml:mi>i</mml:mi></mml:mrow></mml:msub></mml:math></inline-formula> in this work</th><th colspan="1" rowspan="1"><inline-formula id="IEq21"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e1948"><mml:msub><mml:mrow><mml:mi>τ</mml:mi></mml:mrow><mml:mrow><mml:mi>i</mml:mi></mml:mrow></mml:msub></mml:math></inline-formula> in Ref. <sup><xref rid="CR23" ref-type="bibr">23</xref></sup></th></tr></thead><tbody><tr><td rowspan="3" colspan="1">30°C</td><td colspan="1" rowspan="1">1</td><td colspan="1" rowspan="1">0.4590</td><td colspan="1" rowspan="1">0.4248</td><td colspan="1" rowspan="1">15.115</td><td colspan="1" rowspan="1">14.368</td></tr><tr><td colspan="1" rowspan="1">2</td><td colspan="1" rowspan="1">0.2371</td><td colspan="1" rowspan="1">0.2436</td><td colspan="1" rowspan="1">66.512</td><td colspan="1" rowspan="1">37.209</td></tr><tr><td colspan="1" rowspan="1">3</td><td colspan="1" rowspan="1">0.1538</td><td colspan="1" rowspan="1">0.3315</td><td colspan="1" rowspan="1">338.661</td><td colspan="1" rowspan="1">161.71</td></tr><tr><td rowspan="3" colspan="1">60°C</td><td colspan="1" rowspan="1">1</td><td colspan="1" rowspan="1">0.6780</td><td colspan="1" rowspan="1">0.8166</td><td colspan="1" rowspan="1">4.608</td><td colspan="1" rowspan="1">15.034</td></tr><tr><td colspan="1" rowspan="1">2</td><td colspan="1" rowspan="1">0.1504</td><td colspan="1" rowspan="1">0.1666</td><td colspan="1" rowspan="1">24.992</td><td colspan="1" rowspan="1">203.425</td></tr><tr><td colspan="1" rowspan="1">3</td><td colspan="1" rowspan="1">0.0839</td><td colspan="1" rowspan="1">-</td><td colspan="1" rowspan="1">184.486</td><td colspan="1" rowspan="1">-</td></tr><tr><td rowspan="3" colspan="1">85°C</td><td colspan="1" rowspan="1">1</td><td colspan="1" rowspan="1">0.5282</td><td colspan="1" rowspan="1">0.6172</td><td colspan="1" rowspan="1">4.761</td><td colspan="1" rowspan="1">16.281</td></tr><tr><td colspan="1" rowspan="1">2</td><td colspan="1" rowspan="1">0.2293</td><td colspan="1" rowspan="1">0.2256</td><td colspan="1" rowspan="1">25.734</td><td colspan="1" rowspan="1">118.25</td></tr><tr><td colspan="1" rowspan="1">3</td><td colspan="1" rowspan="1">0.1799</td><td colspan="1" rowspan="1">0.1563</td><td colspan="1" rowspan="1">241.154</td><td colspan="1" rowspan="1">236.26</td></tr></tbody></table></table-wrap><p id="Par34">To assess the model’s external validity, a comparison was conducted with the generalized Maxwell fit reported in Ref. <sup><xref rid="CR23" ref-type="bibr">23</xref></sup>, as both studies used the same experimental conditions and sample material. As shown in Fig. <xref rid="Fig3" ref-type="fig">3b</xref> and detailed in Table <xref rid="Tab1" ref-type="table">1</xref>, both models successfully capture the temperature-dependent viscoelastic behavior of OCA. However, at 60 °C, the second-order model used in Ref. <sup><xref rid="CR23" ref-type="bibr">23</xref></sup> shows notable deviations in the intermediate time range. In contrast, the third-order model employed here—using the same dataset—achieves significantly improved accuracy, with the coefficient of determination increasing from <italic>R</italic><sup>2</sup>&gt;0.97 to <italic>R</italic><sup>2</sup>=0.9998. This confirms the superior capability of the third-order formulation in resolving multi-scale relaxation dynamics, particularly in capturing mid-term transitions.</p><p id="Par35">To further refine the quantitative characterization of OCA’s viscoelasticity, we complemented the analysis with dynamic mechanical testing. The storage-modulus data obtained from the temperature sweeps were processed using the time-temperature superposition (TTS) principle. The modulus curves measured at different temperatures were horizontally shifted along the logarithmic time axis to construct a storage-modulus master curve at a reference temperature of 0 °C, as shown in Fig. <xref rid="Fig3" ref-type="fig">3c</xref>. The fitting results indicate that the model accurately captures the viscoelastic behavior across a wide range of temperatures, providing a reliable basis for further analysis. The master curve was then fitted using a third-order generalized Maxwell model, enabling faithful representation of the viscoelastic response over extended time scales. As shown in Fig. <xref rid="Fig3" ref-type="fig">3d</xref>, the fitted master curve provides a clear depiction of the viscoelastic behavior across various temperatures, further supporting the validity of the model.The corresponding parameters for the third-order Prony series are as follows:g<sub>1</sub> = 0.845,τ<sub>1</sub> = 2.18×10<sup>-4</sup>;g<sub>2</sub> = 0.911,<italic>τ</italic><sub>2i</sub> = 1.69×10<sup>-3</sup>;and g<sub>3</sub> = 0.354,τ<sub>4</sub> = 3.68×10<sup>-2</sup>.Additionally, the analysis of the shift factors obtained during master-curve construction confirms the effectiveness of the time-temperature superposition principle in capturing the material’s behavior at different temperatures. Fitting of the shift factors obtained during master-curve construction revealed that the high-temperature regime (T&gt;<italic>T</italic><sub><italic>g</italic></sub>, where <italic>T</italic><sub><italic>g</italic></sub> refers to the glass transition temperature of the material) follows the Williams-Landel-Ferry (WLF) equation, whereas the low-temperature regime (T&lt;<italic>T</italic><sub><italic>g</italic></sub>) conforms to an Arrhenius relation, as follows:</p><disp-formula id="Equ20"><label>20</label><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e2143" display="block"><mml:mrow><mml:mfrac><mml:mn>1</mml:mn><mml:msubsup><mml:mi>log</mml:mi><mml:mn>10</mml:mn><mml:mi mathvariant="normal">T</mml:mi></mml:msubsup></mml:mfrac><mml:mo>=</mml:mo><mml:mfrac><mml:mrow><mml:mi mathvariant="normal">R</mml:mi><mml:mo>⋅</mml:mo><mml:msubsup><mml:mi>log</mml:mi><mml:mi mathvariant="normal">e</mml:mi><mml:mn>10</mml:mn></mml:msubsup></mml:mrow><mml:mrow><mml:mi mathvariant="normal">δ</mml:mi><mml:mi mathvariant="normal">H</mml:mi></mml:mrow></mml:mfrac><mml:mo>⋅</mml:mo><mml:msup><mml:mrow><mml:mfenced><mml:mrow><mml:mfrac><mml:mn>1</mml:mn><mml:mrow><mml:mi mathvariant="normal">T</mml:mi><mml:mo>+</mml:mo><mml:mn>273</mml:mn></mml:mrow></mml:mfrac><mml:mo>−</mml:mo><mml:mfrac><mml:mn>1</mml:mn><mml:mrow><mml:msub><mml:mi mathvariant="normal">T</mml:mi><mml:mi>ref</mml:mi></mml:msub><mml:mo>+</mml:mo><mml:mn>273</mml:mn></mml:mrow></mml:mfrac></mml:mrow></mml:mfenced></mml:mrow><mml:mrow><mml:mo>−</mml:mo><mml:mn>1</mml:mn></mml:mrow></mml:msup><mml:mo>=</mml:mo><mml:mi mathvariant="normal">k</mml:mi><mml:mo>⋅</mml:mo><mml:mfrac><mml:mn>1</mml:mn><mml:mi mathvariant="normal">T</mml:mi></mml:mfrac><mml:mo>+</mml:mo><mml:mi mathvariant="normal">b</mml:mi><mml:mspace width="0.25em"/><mml:mi mathvariant="normal">T</mml:mi><mml:mo>&lt;</mml:mo><mml:mn>273</mml:mn><mml:mi mathvariant="normal">K</mml:mi></mml:mrow></mml:math></disp-formula><disp-formula id="Equ21"><label>21</label><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e2220" display="block"><mml:mrow><mml:msubsup><mml:mi>log</mml:mi><mml:mn>10</mml:mn><mml:mi mathvariant="normal">T</mml:mi></mml:msubsup><mml:mo>=</mml:mo><mml:mo>−</mml:mo><mml:mfrac><mml:mrow><mml:msub><mml:mi mathvariant="normal">C</mml:mi><mml:mn>1</mml:mn></mml:msub><mml:mfenced><mml:mrow><mml:mi mathvariant="normal">T</mml:mi><mml:mo>−</mml:mo><mml:msub><mml:mi mathvariant="normal">T</mml:mi><mml:mi>ref</mml:mi></mml:msub></mml:mrow></mml:mfenced></mml:mrow><mml:mrow><mml:msub><mml:mi mathvariant="normal">C</mml:mi><mml:mn>2</mml:mn></mml:msub><mml:mo>+</mml:mo><mml:mfenced><mml:mrow><mml:mi mathvariant="normal">T</mml:mi><mml:mo>−</mml:mo><mml:msub><mml:mi mathvariant="normal">T</mml:mi><mml:mi>ref</mml:mi></mml:msub></mml:mrow></mml:mfenced></mml:mrow></mml:mfrac><mml:mspace width="0.25em"/><mml:mi mathvariant="normal">T</mml:mi><mml:mo>&gt;</mml:mo><mml:mn>273</mml:mn><mml:mi mathvariant="normal">K</mml:mi></mml:mrow></mml:math></disp-formula><p id="Par36">In these expressions, C1 and C2 are the universal constants of the WLF equation; the reference temperature is set to Tref=0°C; and<inline-formula id="IEq22"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e2275"><mml:mrow><mml:mi mathvariant="normal">δ</mml:mi><mml:mi mathvariant="normal">H</mml:mi></mml:mrow></mml:math></inline-formula> denotes the activation energy. The fitting results for the two relations are presented in Fig. <xref rid="Fig3" ref-type="fig">3e</xref>. The corresponding parameters for the WLF equation are C1 = -314.2019 and C2 = 43.9834, while the parameters for the Arrhenius equation are k = 8.9812 and b = -0.0023064. They correspond, respectively, to relaxation mechanisms dominated by segmental motion and by small-molecule motion, consistent with the temperature dependence of chain mobility observed in the stress-relaxation experiments.</p><p id="Par37">The mutual corroboration between dynamic and static viscoelastic tests provides multi-dimensional parameter support for constructing the OCA viscoelastic constitutive model, ensuring accurate representation of the material’s mechanical response across broad temperature and time scales.</p></sec><sec id="Sec11" disp-level="2"><title>Parameter Identification for the Viscoelastic-Viscoplastic Constitutive Model</title><p id="Par38">Building on a combined generalized Maxwell viscoelastic model and the Qian-Liu viscoplastic framework, we performed parameter identification from stress-relaxation experiments conducted at 30, 60, and 85 °C. The fitted responses are shown in Fig. <xref rid="Fig3" ref-type="fig">3f</xref>, and the identified parameters are summarized in Table <xref rid="Tab2" ref-type="table">2</xref>. By incorporating back-stress and strain-hardening terms, the model systematically elucidates the temperature-dependent mechanisms governing the material response and enables comparison and validation against established frameworks in the literature.</p><table-wrap id="Tab2" position="float"><?disp-level 3?><label>Table 2</label><caption><p>Identified parameters for the viscoelastic-viscoplastic constitutive model</p></caption><table frame="hsides" rules="groups"><thead><tr><th colspan="1" rowspan="1">Parameter category</th><th colspan="1" rowspan="1">Parameter</th><th colspan="1" rowspan="1">30°C</th><th colspan="1" rowspan="1">60°C</th><th colspan="1" rowspan="1">85°C</th></tr></thead><tbody><tr><td colspan="1" rowspan="1">Viscoplastic parameters</td><td colspan="1" rowspan="1"><inline-formula id="IEq23"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e2330"><mml:mi>A</mml:mi></mml:math></inline-formula></td><td colspan="1" rowspan="1">0.000217 <inline-formula id="IEq24"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e2339"><mml:msup><mml:mrow><mml:mi mathvariant="normal">MPa</mml:mi></mml:mrow><mml:mrow><mml:mo>−</mml:mo><mml:mn>1</mml:mn></mml:mrow></mml:msup></mml:math></inline-formula></td><td colspan="1" rowspan="1">32.357 <inline-formula id="IEq25"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e2354"><mml:msup><mml:mrow><mml:mi mathvariant="normal">MPa</mml:mi></mml:mrow><mml:mrow><mml:mo>−</mml:mo><mml:mn>1</mml:mn></mml:mrow></mml:msup></mml:math></inline-formula></td><td colspan="1" rowspan="1">55.2781 <inline-formula id="IEq26"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e2369"><mml:msup><mml:mrow><mml:mi mathvariant="normal">MPa</mml:mi></mml:mrow><mml:mrow><mml:mo>−</mml:mo><mml:mn>1</mml:mn></mml:mrow></mml:msup></mml:math></inline-formula></td></tr><tr><td colspan="1" rowspan="1"/><td colspan="1" rowspan="1"><inline-formula id="IEq27"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e2385"><mml:msub><mml:mrow><mml:mi>A</mml:mi></mml:mrow><mml:mrow><mml:mn>1</mml:mn></mml:mrow></mml:msub></mml:math></inline-formula></td><td colspan="1" rowspan="1">992.295<inline-formula id="IEq28"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e2398"><mml:msup><mml:mrow><mml:mi mathvariant="normal">MPa</mml:mi></mml:mrow><mml:mrow><mml:mo>−</mml:mo><mml:mn>1</mml:mn></mml:mrow></mml:msup></mml:math></inline-formula></td><td colspan="1" rowspan="1">815.396<inline-formula id="IEq29"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e2413"><mml:msup><mml:mrow><mml:mi mathvariant="normal">MPa</mml:mi></mml:mrow><mml:mrow><mml:mo>−</mml:mo><mml:mn>1</mml:mn></mml:mrow></mml:msup></mml:math></inline-formula></td><td colspan="1" rowspan="1">805.166<inline-formula id="IEq30"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e2428"><mml:msup><mml:mrow><mml:mi mathvariant="normal">MPa</mml:mi></mml:mrow><mml:mrow><mml:mo>−</mml:mo><mml:mn>1</mml:mn></mml:mrow></mml:msup></mml:math></inline-formula></td></tr><tr><td colspan="1" rowspan="1"/><td colspan="1" rowspan="1"><inline-formula id="IEq31"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e2444"><mml:msub><mml:mrow><mml:mi>A</mml:mi></mml:mrow><mml:mrow><mml:mn>2</mml:mn></mml:mrow></mml:msub></mml:math></inline-formula></td><td colspan="1" rowspan="1">992.282<inline-formula id="IEq32"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e2457"><mml:msup><mml:mrow><mml:mi mathvariant="normal">MPa</mml:mi></mml:mrow><mml:mrow><mml:mo>−</mml:mo><mml:mn>1</mml:mn></mml:mrow></mml:msup></mml:math></inline-formula></td><td colspan="1" rowspan="1">813.468<inline-formula id="IEq33"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e2472"><mml:msup><mml:mrow><mml:mi mathvariant="normal">MPa</mml:mi></mml:mrow><mml:mrow><mml:mo>−</mml:mo><mml:mn>1</mml:mn></mml:mrow></mml:msup></mml:math></inline-formula></td><td colspan="1" rowspan="1">804.600<inline-formula id="IEq34"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e2487"><mml:msup><mml:mrow><mml:mi mathvariant="normal">MPa</mml:mi></mml:mrow><mml:mrow><mml:mo>−</mml:mo><mml:mn>1</mml:mn></mml:mrow></mml:msup></mml:math></inline-formula></td></tr><tr><td colspan="1" rowspan="1"/><td colspan="1" rowspan="1"><inline-formula id="IEq35"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e2503"><mml:msub><mml:mrow><mml:mi>H</mml:mi></mml:mrow><mml:mrow><mml:mn>1</mml:mn></mml:mrow></mml:msub></mml:math></inline-formula></td><td colspan="1" rowspan="1">23.1466<inline-formula id="IEq36"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e2516"><mml:mi mathvariant="normal">MPa</mml:mi></mml:math></inline-formula></td><td colspan="1" rowspan="1">393.812<inline-formula id="IEq37"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e2526"><mml:mi mathvariant="normal">MPa</mml:mi></mml:math></inline-formula></td><td colspan="1" rowspan="1">139.369<inline-formula id="IEq38"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e2536"><mml:mi mathvariant="normal">MPa</mml:mi></mml:math></inline-formula></td></tr><tr><td colspan="1" rowspan="1"/><td colspan="1" rowspan="1"><inline-formula id="IEq39"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e2547"><mml:msub><mml:mrow><mml:mi>H</mml:mi></mml:mrow><mml:mrow><mml:mn>2</mml:mn></mml:mrow></mml:msub></mml:math></inline-formula></td><td colspan="1" rowspan="1">79.796<inline-formula id="IEq40"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e2560"><mml:mi mathvariant="normal">MPa</mml:mi></mml:math></inline-formula></td><td colspan="1" rowspan="1">272.154<inline-formula id="IEq41"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e2570"><mml:mi mathvariant="normal">MPa</mml:mi></mml:math></inline-formula></td><td colspan="1" rowspan="1">205.569<inline-formula id="IEq42"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e2580"><mml:mi mathvariant="normal">MPa</mml:mi></mml:math></inline-formula></td></tr><tr><td colspan="1" rowspan="1">Viscoelastic parameters</td><td colspan="1" rowspan="1"><inline-formula id="IEq43"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e2592"><mml:msub><mml:mrow><mml:mi>E</mml:mi></mml:mrow><mml:mrow><mml:mi>∞</mml:mi></mml:mrow></mml:msub></mml:math></inline-formula></td><td colspan="1" rowspan="1">0.0153<inline-formula id="IEq44"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e2605"><mml:mi mathvariant="normal">MPa</mml:mi></mml:math></inline-formula></td><td colspan="1" rowspan="1">0.0116<inline-formula id="IEq45"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e2615"><mml:mi mathvariant="normal">MPa</mml:mi></mml:math></inline-formula></td><td colspan="1" rowspan="1">0.0068<inline-formula id="IEq46"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e2625"><mml:mi mathvariant="normal">MPa</mml:mi></mml:math></inline-formula></td></tr><tr><td colspan="1" rowspan="1"/><td colspan="1" rowspan="1"><inline-formula id="IEq47"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e2636"><mml:msub><mml:mrow><mml:mi>E</mml:mi></mml:mrow><mml:mrow><mml:mn>1</mml:mn></mml:mrow></mml:msub></mml:math></inline-formula></td><td colspan="1" rowspan="1">0.0185<inline-formula id="IEq48"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e2649"><mml:mi mathvariant="normal">MPa</mml:mi></mml:math></inline-formula></td><td colspan="1" rowspan="1">0.0459<inline-formula id="IEq49"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e2659"><mml:mi mathvariant="normal">MPa</mml:mi></mml:math></inline-formula></td><td colspan="1" rowspan="1">0.0079<inline-formula id="IEq50"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e2669"><mml:mi mathvariant="normal">MPa</mml:mi></mml:math></inline-formula></td></tr><tr><td colspan="1" rowspan="1"/><td colspan="1" rowspan="1"><inline-formula id="IEq51"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e2680"><mml:msub><mml:mrow><mml:mi>E</mml:mi></mml:mrow><mml:mrow><mml:mn>2</mml:mn></mml:mrow></mml:msub></mml:math></inline-formula></td><td colspan="1" rowspan="1">0.0449<inline-formula id="IEq52"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e2693"><mml:mi mathvariant="normal">MPa</mml:mi></mml:math></inline-formula></td><td colspan="1" rowspan="1">0.0102<inline-formula id="IEq53"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e2703"><mml:mi mathvariant="normal">MPa</mml:mi></mml:math></inline-formula></td><td colspan="1" rowspan="1">0.0138<inline-formula id="IEq54"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e2713"><mml:mi mathvariant="normal">MPa</mml:mi></mml:math></inline-formula></td></tr><tr><td colspan="1" rowspan="1"/><td colspan="1" rowspan="1"><inline-formula id="IEq55"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e2724"><mml:msub><mml:mrow><mml:mi>E</mml:mi></mml:mrow><mml:mrow><mml:mn>3</mml:mn></mml:mrow></mml:msub></mml:math></inline-formula></td><td colspan="1" rowspan="1">0.0241<inline-formula id="IEq56"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e2737"><mml:mi mathvariant="normal">MPa</mml:mi></mml:math></inline-formula></td><td colspan="1" rowspan="1">0.0088<inline-formula id="IEq57"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e2747"><mml:mi mathvariant="normal">MPa</mml:mi></mml:math></inline-formula></td><td colspan="1" rowspan="1">0.0192<inline-formula id="IEq58"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e2757"><mml:mi mathvariant="normal">MPa</mml:mi></mml:math></inline-formula></td></tr><tr><td colspan="1" rowspan="1"/><td colspan="1" rowspan="1"><inline-formula id="IEq59"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e2768"><mml:msub><mml:mrow><mml:mi>τ</mml:mi></mml:mrow><mml:mrow><mml:mn>1</mml:mn></mml:mrow></mml:msub></mml:math></inline-formula></td><td colspan="1" rowspan="1">0.415S</td><td colspan="1" rowspan="1">5.060S</td><td colspan="1" rowspan="1">7.859S</td></tr><tr><td colspan="1" rowspan="1"/><td colspan="1" rowspan="1"><inline-formula id="IEq60"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e2788"><mml:msub><mml:mrow><mml:mi>τ</mml:mi></mml:mrow><mml:mrow><mml:mn>2</mml:mn></mml:mrow></mml:msub></mml:math></inline-formula></td><td colspan="1" rowspan="1">18.451S</td><td colspan="1" rowspan="1">34.119S</td><td colspan="1" rowspan="1">32.510S</td></tr><tr><td colspan="1" rowspan="1"/><td colspan="1" rowspan="1"><inline-formula id="IEq61"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e2809"><mml:msub><mml:mrow><mml:mi>τ</mml:mi></mml:mrow><mml:mrow><mml:mn>3</mml:mn></mml:mrow></mml:msub></mml:math></inline-formula></td><td colspan="1" rowspan="1">146.756S</td><td colspan="1" rowspan="1">224.995S</td><td colspan="1" rowspan="1">276.661S</td></tr></tbody></table></table-wrap><p id="Par39">In the viscoelastic part, the fittings indicate that the instantaneous modulus and the modal relaxation moduli decrease progressively with increasing temperature, whereas the relaxation times shift toward longer time scales. This trend suggests that, at low temperatures, chain segments are relatively constrained—yielding a higher modulus and rapid initial relaxation—while rising temperature markedly increases the degrees of freedom of segmental thermal motion, leading to an overall reduction in stiffness and a delayed relaxation process. This observation aligns with the conclusions of He et al. for encapsulation underfills within a modified Qian-Liu framework, namely that mechanical properties deteriorate rapidly near the glass-transition region with a pronounced drop in modulus, and that temperature-dependent apparent activation-energy or hardening-stress terms are required to adjust the predictive model so as to capture this sharp decay.</p><p id="Par40">In the viscoplastic regime, the temperature dependence of the back-stress coefficients <italic>A</italic>, <italic>A</italic><sub>1</sub>, <italic>A</italic><sub>2</sub> and the strain-hardening coefficients <italic>H</italic><sub>1</sub>, <italic>H</italic><sub>2</sub> further elucidates differences in the inelastic evolution mechanisms. The results show that, with increasing temperature, the <italic>A</italic> parameters exhibit a pronounced upward trend, whereas <inline-formula id="IEq62"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e2852"><mml:msub><mml:mrow><mml:mi>A</mml:mi></mml:mrow><mml:mrow><mml:mn>1</mml:mn></mml:mrow></mml:msub></mml:math></inline-formula> and <inline-formula id="IEq63"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e2863"><mml:msub><mml:mrow><mml:mi>A</mml:mi></mml:mrow><mml:mrow><mml:mn>2</mml:mn></mml:mrow></mml:msub></mml:math></inline-formula> gradually decline,implying that at elevated temperatures the back-stress term contributes more strongly to the magnitude and accumulation rate of inelastic flow, indicative of enhanced viscous drag and dynamic recovery effects. This is consistent with the mechanism emphasized by He et al.<sup><xref rid="CR18" ref-type="bibr">18</xref></sup>, namely increased chain disentanglement and greater freedom of molecular motion. Meanwhile, the hardening coefficients <italic>H</italic><sub>1</sub> and <italic>H</italic><sub>2</sub> reach a maximum near 60 °C and recede at 85 °C. This“mid-temperature strengthening-high-temperature weakening”behavior accords with the parameter-identification logic of the Qian-Liu framework: <italic>H</italic><sub>1</sub> and <italic>H</italic><sub>2</sub> are governed by transient features of deformation, and, in the vicinity of the glass-transition region at elevated temperatures, matrix softening reduces the strain-hardening rate, leading to their decline.</p><p id="Par41">It is worth emphasizing that the physical meanings of the back-stress parameters (<inline-formula id="IEq64"><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="d33e2897"><mml:mi>A</mml:mi></mml:math></inline-formula>、<italic>A</italic><sub>1</sub>、<italic>A</italic><sub>2</sub>) and the hardening coefficients(<italic>H</italic><sub>1</sub>、<italic>H</italic><sub>2</sub>)are explicitly defined in the original Qian-Liu framework: the former characterize the accumulation and amplitude modulation of short and long-range back stresses, whereas the latter govern the evolution rate of back stress and the extent of hardening<sup><xref rid="CR40" ref-type="bibr">40</xref></sup>. The temperature-dependent trends identified here are highly consistent with reports of enhanced viscoplastic flow and rapid degradation of mechanical properties at elevated temperatures, thereby further corroborating the applicability of the Qian-Liu model to polymer-based underfill materials.</p><p id="Par42">Taken together, the fitted results not only quantify the temperature-driven evolution of viscoelastic-viscoplastic behavior, but are also mechanistically consistent with the central tenets of the Qian-Liu framework and its subsequent modifications. Parametric analysis confirms that the response is viscoelasticity-dominated at low temperatures, whereas viscoplastic contributions intensify markedly at elevated temperatures; accordingly, back-stress effects and strain-hardening mechanisms exhibit pronounced temperature dependence. These findings provide a robust experimental and theoretical basis for constructing a unified, temperature-dependent constitutive description.</p></sec><sec id="Sec12" disp-level="2"><title>Finite-Element Simulation Analysis</title><sec id="Sec13" disp-level="3"><title>Simulation Setup</title><p id="Par43">To investigate the temperature-dependent mechanical response of OCA, a finite-element model of a flexible display was developed in ABAQUS. The overall model represents the thin-film stack of the display, and two rigid bending rollers were introduced at the mid-span to impose a bending configuration, as shown in Fig. <xref rid="Fig4" ref-type="fig">4a</xref>. Each roller has a diameter of 2 mm; one roller is fixed while the other translates downward at a prescribed velocity, thereby inducing bending of the adhesive layer and adjacent regions of the display. The right end of the panel is constrained, whereas the remaining portion is allowed to deform freely under bending so as to reflect realistic loading conditions. Contact between the rollers and the display was defined as surface-to-surface hard contact: a “hard” normal constraint was employed, and tangential behavior included friction with a coefficient of 0.02 to better approximate practical conditions. The material parameters assigned to each film layer in the stack are summarized in Table <xref rid="Tab3" ref-type="table">3</xref>, and the main contact settings in ABAQUS are presented in Table <xref rid="Tab4" ref-type="table">4</xref>.</p><fig id="Fig4" position="float"><?disp-level 4?><label>Fig. 4</label><caption><title>Finite-element simulation setup and bending deformation.</title><p><bold>a</bold> Geometric model of the flexible display; <bold>b</bold> finite-element mesh; <bold>c</bold> schematic of displacement evolution during bending</p></caption><alternatives><graphic xmlns:xlink="http://www.w3.org/1999/xlink" content-type="image" id="d33e2955" xlink:href="41378_2026_1342_Fig4_HTML.jpg"><?cloudpmc-path blobs/3fd8/13284314/3bfa5b77787f/41378_2026_1342_Fig4_HTML.jpg?><?cloudpmc-bucket cdn?><?image-server-status NEED_LOADING?><?original-height 1358?><?original-width 1924?><?scaled-height 543?><?scaled-width 769?></graphic><graphic xmlns:xlink="http://www.w3.org/1999/xlink" content-type="thumb" xlink:href="41378_2026_1342_Fig4_HTML.gif"><?cloudpmc-path blobs/3fd8/13284314/19fd9ed4cd9e/41378_2026_1342_Fig4_HTML.gif?><?cloudpmc-bucket cdn?></graphic></alternatives></fig><table-wrap id="Tab3" position="float"><?disp-level 4?><label>Table 3</label><caption><p>Material parameters of each layer of film</p></caption><table frame="hsides" rules="groups"><thead><tr><th colspan="1" rowspan="1">Film Material</th><th colspan="1" rowspan="1">Elasticity Modulus(MPa)</th><th colspan="1" rowspan="1">Poisson’s ratio</th></tr></thead><tbody><tr><td colspan="1" rowspan="1">Cover Plate</td><td colspan="1" rowspan="1">3500</td><td colspan="1" rowspan="1">0.29</td></tr><tr><td colspan="1" rowspan="1">Polarizer</td><td colspan="1" rowspan="1">3769</td><td colspan="1" rowspan="1">0.33</td></tr><tr><td colspan="1" rowspan="1">Backplane</td><td colspan="1" rowspan="1">5030</td><td colspan="1" rowspan="1">0.32</td></tr><tr><td colspan="1" rowspan="1">Metal Substrate</td><td colspan="1" rowspan="1">56590</td><td colspan="1" rowspan="1">0.33</td></tr></tbody></table></table-wrap><table-wrap id="Tab4" position="float"><?disp-level 4?><label>Table 4</label><caption><p>Main contact settings in ABAQUS</p></caption><table frame="hsides" rules="groups"><thead><tr><th colspan="1" rowspan="1">Parameters</th><th colspan="1" rowspan="1">Details</th><th colspan="1" rowspan="1">Type</th></tr></thead><tbody><tr><td colspan="1" rowspan="1">Step</td><td colspan="1" rowspan="1">Geometric Nonlinearity</td><td colspan="1" rowspan="1">on</td></tr><tr><td rowspan="3" colspan="1">Interaction</td><td colspan="1" rowspan="1">Discretization Method</td><td colspan="1" rowspan="1">Surface to Surface</td></tr><tr><td colspan="1" rowspan="1">Normal Behavior</td><td colspan="1" rowspan="1">“Hard” contact</td></tr><tr><td colspan="1" rowspan="1">Tangential Behavior</td><td colspan="1" rowspan="1">Penalty</td></tr><tr><td colspan="1" rowspan="1">Load</td><td colspan="1" rowspan="1">Boundary Condition</td><td colspan="1" rowspan="1">Fixed/Displacement</td></tr><tr><td colspan="1" rowspan="1">Geometric Modification</td><td colspan="1" rowspan="1">Interface Treatment</td><td colspan="1" rowspan="1">Adjust to Touch</td></tr></tbody></table></table-wrap><p id="Par44">For discretization, the OCA layer was meshed with CPE4 four-node plane-stress elements; the rollers were modeled as rigid bodies, and loading was applied via a reference point. To enhance accuracy, local mesh refinement was introduced in the bending region to capture stress concentrations, as illustrated in Fig. <xref rid="Fig4" ref-type="fig">4b</xref>. To ensure numerical accuracy, bending simulations under identical conditions were performed using meshes with 27,489, 43,852, and 160,000 elements. The relative error of the maximum stress among these meshes is less than 5%, confirming that the results are mesh-independent. Regarding material behavior, the functional film layers were treated as linear elastic, whereas the OCA layer was analyzed using two constitutive alternatives: a viscoelastic model based on the generalized Maxwell formulation and a viscoelastic-viscoplastic model that augments the former with a plastic slip mechanism to more faithfully represent irreversible deformation at elevated temperatures. Model parameters were taken from the preceding experimental identification, and simulations were carried out at 30, 60, and 85 °C. The evolution of the imposed displacement during bending is depicted in Fig. <xref rid="Fig4" ref-type="fig">4c</xref>.</p></sec><sec id="Sec14" disp-level="3"><title>Simulation Results and Comparative Analysis</title><p id="Par45">Figure <xref rid="Fig5" ref-type="fig">5</xref> summarizes the UMAT workflow implemented in ABAQUS. Figures <xref rid="Fig6" ref-type="fig">6</xref> and <xref rid="Fig7" ref-type="fig">7</xref> compare the simulated stress fields obtained under identical geometry, loading, and contact conditions using a purely viscoelastic (VE) description and a coupled viscoelastic-viscoplastic (VE-VP) formulation. Both frameworks reproduce the overall topology of the macroscopic stress distribution; however, they differ in peak magnitudes and in their temperature dependence. For the VE model, the peak stress is 58.8 MPa at 30 °C, increasing to 61.1 MPa and 69.1 MPa at 60 °C and 85 °C, respectively,indicating a temperature-induced intensification of stress concentration. In contrast, the VE-VP model predicts consistently lower peak stresses—50.6 MPa at 30 °C, 53.8 MPa at 60 °C, and 54.2 MPa at 85 °C—corresponding to decreases of 13.9%, 11.9%, and 21.6% relative to the VE results. Overall, the VE-VP formulation results in lower peak stresses at all temperatures and a weaker temperature sensitivity compared with the VE model, indicating moderated stress concentrations under identical geometry, loading, and contact conditions.</p><fig id="Fig5" position="float"><?disp-level 4?><label>Fig. 5</label><caption><title>Workflow of the ABAQUS UMAT subroutine.</title><p>UMAT calculation workflow: input reception, plastic deformation judgment, strain and stiffness calculation, iterative residual stress correction, and stress-strain update</p></caption><alternatives><graphic xmlns:xlink="http://www.w3.org/1999/xlink" content-type="image" id="d33e3086" xlink:href="41378_2026_1342_Fig5_HTML.jpg"><?cloudpmc-path blobs/3fd8/13284314/4ea9b3d1bce0/41378_2026_1342_Fig5_HTML.jpg?><?cloudpmc-bucket cdn?><?image-server-status NEED_LOADING?><?original-height 1530?><?original-width 1501?><?scaled-height 764?><?scaled-width 750?></graphic><graphic xmlns:xlink="http://www.w3.org/1999/xlink" content-type="thumb" xlink:href="41378_2026_1342_Fig5_HTML.gif"><?cloudpmc-path blobs/3fd8/13284314/6781e9499fee/41378_2026_1342_Fig5_HTML.gif?><?cloudpmc-bucket cdn?></graphic></alternatives></fig><fig id="Fig6" position="float"><?disp-level 4?><label>Fig. 6</label><caption><title>Representative simulation results of the viscoelastic constitutive model.</title><p>von Mises stress distribution at <bold>a</bold> 30 °C, <bold>b</bold> 60 °C, <bold>c</bold> 85 °C</p></caption><alternatives><graphic xmlns:xlink="http://www.w3.org/1999/xlink" content-type="image" id="d33e3104" xlink:href="41378_2026_1342_Fig6_HTML.jpg"><?cloudpmc-path blobs/3fd8/13284314/f0e2afc8271a/41378_2026_1342_Fig6_HTML.jpg?><?cloudpmc-bucket cdn?><?image-server-status NEED_LOADING?><?original-height 1074?><?original-width 1917?><?scaled-height 429?><?scaled-width 766?></graphic><graphic xmlns:xlink="http://www.w3.org/1999/xlink" content-type="thumb" xlink:href="41378_2026_1342_Fig6_HTML.gif"><?cloudpmc-path blobs/3fd8/13284314/9dae33e2f7b2/41378_2026_1342_Fig6_HTML.gif?><?cloudpmc-bucket cdn?></graphic></alternatives></fig><fig id="Fig7" position="float"><?disp-level 4?><label>Fig. 7</label><caption><title>Representative simulation results of the viscoelastic–viscoplastic constitutive model.</title><p>von Mises stress distribution at <bold>a</bold> 30 °C, <bold>b</bold> 60 °C, <bold>c</bold> 85 °C</p></caption><alternatives><graphic xmlns:xlink="http://www.w3.org/1999/xlink" content-type="image" id="d33e3122" xlink:href="41378_2026_1342_Fig7_HTML.jpg"><?cloudpmc-path blobs/3fd8/13284314/8ee534389298/41378_2026_1342_Fig7_HTML.jpg?><?cloudpmc-bucket cdn?><?image-server-status NEED_LOADING?><?original-height 822?><?original-width 1924?><?scaled-height 329?><?scaled-width 769?></graphic><graphic xmlns:xlink="http://www.w3.org/1999/xlink" content-type="thumb" xlink:href="41378_2026_1342_Fig7_HTML.gif"><?cloudpmc-path blobs/3fd8/13284314/92130d18fdc1/41378_2026_1342_Fig7_HTML.gif?><?cloudpmc-bucket cdn?></graphic></alternatives></fig><p id="Par46">To further elucidate how the viscoelastic and viscoplastic mechanisms give rise to these field-level differences in stress distribution and deformation evolution, we extracted the local stress–strain response and the strain-energy evolution from ABAQUS. The corresponding output variables (stress–strain and strain energy–time) are summarized in Table <xref rid="Tab5" ref-type="table">5</xref>. The extracted data were then used to plot the stress–strain and strain energy–time curves for both the VE and VE-VP models at different temperatures, as shown in Fig. <xref rid="Fig8" ref-type="fig">8</xref>. The results show that, at the initial stage, the local strain levels predicted by the two models remain low and their responses are relatively close. As bending proceeds into the intermediate-to-late stage, the discrepancy between the two frameworks rapidly amplifies: the coupled VE-VP formulation markedly suppresses the local stress level compared with the purely viscoelastic description, consistent with the reduced peak stresses observed in Figs. <xref rid="Fig6" ref-type="fig">6</xref> and <xref rid="Fig7" ref-type="fig">7</xref>.</p><table-wrap id="Tab5" position="float"><?disp-level 4?><label>Table 5</label><caption><p>Key response indicators from FE simulations for VE and VE-VP models</p></caption><table frame="hsides" rules="groups"><thead><tr><th rowspan="2" colspan="1">Temperature</th><th colspan="4" rowspan="1">viscoelastic constitutive model</th><th colspan="4" rowspan="1">viscoelastic–viscoplastic constitutive model</th></tr><tr><th colspan="1" rowspan="1">Stress (MPa)</th><th colspan="1" rowspan="1">Strain</th><th colspan="1" rowspan="1">Time (s)</th><th colspan="1" rowspan="1">Strain Energy</th><th colspan="1" rowspan="1">Stress(MPa)</th><th colspan="1" rowspan="1">Strain</th><th colspan="1" rowspan="1">Time(s)</th><th colspan="1" rowspan="1">Strain Energy</th></tr></thead><tbody><tr><td rowspan="3" colspan="1">30°C</td><td colspan="1" rowspan="1">0.0058</td><td colspan="1" rowspan="1">0.069</td><td colspan="1" rowspan="1">0.758</td><td colspan="1" rowspan="1">0.00030</td><td colspan="1" rowspan="1">0.0026</td><td colspan="1" rowspan="1">0.064</td><td colspan="1" rowspan="1">0.758</td><td colspan="1" rowspan="1">9.19e-5</td></tr><tr><td colspan="1" rowspan="1">0.102</td><td colspan="1" rowspan="1">0.912</td><td colspan="1" rowspan="1">6.28</td><td colspan="1" rowspan="1">0.0359</td><td colspan="1" rowspan="1">0.0234</td><td colspan="1" rowspan="1">0.562</td><td colspan="1" rowspan="1">6.28</td><td colspan="1" rowspan="1">0.0066</td></tr><tr><td colspan="1" rowspan="1">0.105</td><td colspan="1" rowspan="1">0.941</td><td colspan="1" rowspan="1">10</td><td colspan="1" rowspan="1">0.0382</td><td colspan="1" rowspan="1">0.0355</td><td colspan="1" rowspan="1">0.814</td><td colspan="1" rowspan="1">10</td><td colspan="1" rowspan="1">2.0149</td></tr><tr><td rowspan="3" colspan="1">60°C</td><td colspan="1" rowspan="1">0.0091</td><td colspan="1" rowspan="1">0.071</td><td colspan="1" rowspan="1">0.758</td><td colspan="1" rowspan="1">0.00041</td><td colspan="1" rowspan="1">0.0134</td><td colspan="1" rowspan="1">0.058</td><td colspan="1" rowspan="1">0.758</td><td colspan="1" rowspan="1">0.00023</td></tr><tr><td colspan="1" rowspan="1">0.118</td><td colspan="1" rowspan="1">0.946</td><td colspan="1" rowspan="1">6.28</td><td colspan="1" rowspan="1">0.0334</td><td colspan="1" rowspan="1">0.0487</td><td colspan="1" rowspan="1">0.800</td><td colspan="1" rowspan="1">6.28</td><td colspan="1" rowspan="1">0.0142</td></tr><tr><td colspan="1" rowspan="1">0.123</td><td colspan="1" rowspan="1">0.994</td><td colspan="1" rowspan="1">10</td><td colspan="1" rowspan="1">0.0353</td><td colspan="1" rowspan="1">0.0505</td><td colspan="1" rowspan="1">0.840</td><td colspan="1" rowspan="1">10</td><td colspan="1" rowspan="1">0.0155</td></tr><tr><td rowspan="3" colspan="1">85°C</td><td colspan="1" rowspan="1">0.0125</td><td colspan="1" rowspan="1">0.069</td><td colspan="1" rowspan="1">0.758</td><td colspan="1" rowspan="1">0.00051</td><td colspan="1" rowspan="1">0.0153</td><td colspan="1" rowspan="1">0.057</td><td colspan="1" rowspan="1">0.758</td><td colspan="1" rowspan="1">0.00026</td></tr><tr><td colspan="1" rowspan="1">0.195</td><td colspan="1" rowspan="1">0.991</td><td colspan="1" rowspan="1">6.28</td><td colspan="1" rowspan="1">0.0463</td><td colspan="1" rowspan="1">0.0531</td><td colspan="1" rowspan="1">0.807</td><td colspan="1" rowspan="1">6.28</td><td colspan="1" rowspan="1">0.0145</td></tr><tr><td colspan="1" rowspan="1">0.197</td><td colspan="1" rowspan="1">0.995</td><td colspan="1" rowspan="1">10</td><td colspan="1" rowspan="1">0.0491</td><td colspan="1" rowspan="1">0.0544</td><td colspan="1" rowspan="1">0.835</td><td colspan="1" rowspan="1">10</td><td colspan="1" rowspan="1">0.0158</td></tr></tbody></table></table-wrap><fig id="Fig8" position="float"><?disp-level 4?><label>Fig. 8</label><caption><title>Local stress-strain response and total strain energy evolution during bending.</title><p>Stress–strain curves predicted by <bold>a</bold> the viscoelastic constitutive model and b the viscoelastic–viscoplastic constitutive model. <bold>c</bold> Total strain energy (ALLSE) evolution under bending comparing the VE and VE–VP models at 30, 60, and 85 °C</p></caption><alternatives><graphic xmlns:xlink="http://www.w3.org/1999/xlink" content-type="image" id="d33e3151" xlink:href="41378_2026_1342_Fig8_HTML.jpg"><?cloudpmc-path blobs/3fd8/13284314/1df0c508d68d/41378_2026_1342_Fig8_HTML.jpg?><?cloudpmc-bucket cdn?><?image-server-status NEED_LOADING?><?original-height 1245?><?original-width 1477?><?scaled-height 622?><?scaled-width 738?></graphic><graphic xmlns:xlink="http://www.w3.org/1999/xlink" content-type="thumb" xlink:href="41378_2026_1342_Fig8_HTML.gif"><?cloudpmc-path blobs/3fd8/13284314/12e572bd2e84/41378_2026_1342_Fig8_HTML.gif?><?cloudpmc-bucket cdn?></graphic></alternatives></fig><p id="Par47">From an energy perspective, Table <xref rid="Tab5" ref-type="table">5</xref> further indicates that, under the same bending conditions, the accumulated strain energy (ALLSE) predicted by the VE-VP model is consistently and significantly lower than that of the VE model at all temperatures. This demonstrates that introducing viscoplasticity reduces the recoverable energy storage capacity of the system and effectively constrains the overall energy accumulation, thereby providing an energetic explanation for the moderated stress concentration and weakened temperature sensitivity captured by the VE-VP framework.</p></sec></sec></sec><sec id="Sec15" disp-level="1"><title>Conclusions</title><p id="Par48">This study investigates the mechanical response of OCA across multiple temperatures and systematically develops and compares two constitutive descriptions—viscoelastic and viscoelastic-viscoplastic. Key parameters were identified from stress-relaxation and creep-recovery experiments and validated via finite-element simulations. The principal conclusions are as follows:</p><list list-type="order"><list-item><p id="Par49">The viscoelastic mechanical response was characterized using a generalized Maxwell model, revealing a pronounced temperature dependence: increasing temperature enhances segmental mobility and reduces internal dissipation, thereby decreasing both the equilibrium stress and the equilibrium relaxation modulus. At 85 °C the initial stress is approximately 12.6 kPa and the equilibrium relaxation modulus is about 9.51 kPa, representing reductions of 37.72% and 23.61% relative to those at 30 °C and 60 °C, respectively. In dynamic mechanical tests, the storage modulus decreases monotonically with increasing scan temperature—from 1666.3 MPa down to 0.6628 MPa—with the steepest decline occurring near the glass-transition temperature(<italic>T</italic><sub><italic>g</italic></sub> = 0 °C). A generalized Maxwell model with a three-term Prony series accurately reproduces the master-curve data, and temperature shift factors in both the high and low-temperature regimes are well captured by the corresponding fits.</p></list-item><list-item><p id="Par50">In parallel, a viscoelastic-viscoplastic model, constructed by coupling the generalized Maxwell model with the Qian-Liu framework, was compared with the proposed viscoelastic model. Both models faithfully capture the salient features of the OCA stress-relaxation data and accurately reflect the temperature dependence of its mechanical behavior.During the parameter fitting process using the viscoelastic-viscoplastic model, the viscoplastic-related parameters at 60 °C and 85 °C significantly exceed those at 30 °C. This phenomenon indicates that the viscoelastic characteristics of the OCA adhesive diminish with increasing temperature.</p></list-item><list-item><p id="Par51">ABAQUS-based simulations furnish robust theoretical and numerical support for the structural optimization and reliability assessment of flexible OLED devices.</p></list-item></list><p id="Par52">The present results demonstrate that the proposed constitutive–FE framework can effectively capture the temperature-dependent mechanical response of the OCA and provides a feasible basis for device-level stress assessment. However, the current implementation remains subject to limitations: the material parameters were calibrated for a specific OCA under a restricted set of experimental conditions, and the finite-element analysis was conducted using a simplified two-dimensional configuration. Therefore, further work is warranted to validate and extend the framework under more complex loading paths and within more realistic three-dimensional structural models.</p></sec><sec id="ack1" sec-type="ack" disp-level="1"><title>Acknowledgements</title><p>This work was supported by the National Key R&amp;D Program of China (No. 2022YFB3207100), the Hubei Provincial Strategic Scientist Training Plan (No. 2022EJD009), and the Fundamental Research Funds for the Central Universities (No. 2042023kf1041).</p></sec><sec id="notes1" disp-level="1"><title>Data availability</title><p>Data sharing is not applicable to this article as no new date were created or analyzed in this study.</p></sec><sec id="FPar1" disp-level="1"><title>Competing interests</title><p id="Par53">Sheng Liu is an Editor for the journal, the remaining authors have no competing interest.</p></sec><sec id="_ci93_" xml:lang="en" sec-type="contrib-info" disp-level="1"><title>Contributor Information</title><p>Feixiang Tang, Email: thomas0209@whu.edu.cn.</p><p>Sheng Liu, Email: shengliu@whu.edu.cn.</p></sec><sec id="Bib1" sec-type="ref-list" disp-level="1"><title>References</title><sec id="Bib1_sec2" disp-level="2"><ref-list><ref id="CR1"><label>1.</label><mixed-citation id="mc-CR1"><named-content content-type="citation-string">Priyadarshi, A. et al. Characterization of optical properties of acrylate based adhesives exposed to different temperature conditions. <italic>J. Appl. Polym. Sci.</italic><bold>98</bold>, 950–956 (2005).</named-content><ext-link xmlns:xlink="http://www.w3.org/1999/xlink" ext-link-type="google-scholar" xlink:href="Priyadarshi, A. et al. Characterization of optical properties of acrylate based adhesives exposed to different temperature conditions. J. Appl. Polym. Sci.98, 950–956 (2005)."/></mixed-citation></ref><ref id="CR2"><label>2.</label><mixed-citation><named-content content-type="citation-string">Campbell, C. J. Optically clear adhesives. in <italic>Handbook of Visual Display Technology</italic> (eds. Chen, J., Cranton, W. &amp; Fihn, M.), 1501–1514 (Springer International Publishing, 2016).</named-content></mixed-citation></ref><ref id="CR3"><label>3.</label><mixed-citation id="mc-CR3"><named-content content-type="citation-string">Min, J. &amp; Qu, J. Optically clear pressure-sensitive adhesive w
</person-group><article-title>Viscoelastic behavior of filled silicone elastomers and influence of aging in inert and hermetic environment</article-title><source>Contin. Mech. Thermodyn.</source><year>2022</year><fpage>1</fpage><lpage>18</lpage><pub-id pub-id-type="doi">10.1007/s00161-022-01112-9</pub-id></element-citation></ref><ref id="B12-polymers-16-00930"><label>12.</label><element-citation publication-type="journal"><person-group person-group-type="author">
<name name-style="western"><surname>Saseendran</surname><given-names>S.</given-names></name>

<?xml version="1.0" encoding="UTF-8"?><article xml:lang="en" article-type="research-article"><front><journal-meta><journal-id journal-id-type="pmc-domain-id">2507</journal-id><journal-id journal-id-type="pmc-domain">frontbb</journal-id><journal-title-group><journal-title>Frontiers in Bioengineering and Biotechnology</journal-title><abbrev-journal-title>Front Bioeng Biotechnol</abbrev-journal-title></journal-title-group><publisher><publisher-name>Frontiers Media SA</publisher-name></publisher></journal-meta><article-meta><article-id pub-id-type="pmcid">PMC10725245</article-id><article-id pub-id-type="pmcaid">10725245</article-id><article-id pub-id-type="pmcaiid">10725245</article-id><article-id pub-id-type="pmid">38107617</article-id><article-id pub-id-type="doi">10.3389/fbioe.2023.1274673</article-id><title-group><article-title>Mechanical testing and comparison of porcine tissue, silicones and 3D-printed materials for cardiovascular phantoms</article-title></title-group><contrib-group content-type="author"><contrib><name name-style="western"><surname>Illi</surname><given-names initials="J">Joël</given-names></name><xref ref-type="aff" rid="aff1">1</xref></contrib><contrib><name name-style="western"><surname>Ilic</surname><given-names initials="M">Marc</given-names></name><xref ref-type="aff" rid="aff1">1</xref></contrib><contrib><name name-style="western"><surname>Stark</surname><given-names initials="AW">Anselm Walter</given-names></name><xref ref-type="aff" rid="aff1">1</xref></contrib><contrib><name name-style="western"><surname>Amstutz</surname><given-names initials="C">Cornelia</given-names></name><xref ref-type="aff" rid="aff2">2</xref></contrib><contrib><name name-style="western"><surname>Burger</surname><given-names initials="J">Juergen</given-names></name><xref ref-type="aff" rid="aff2">2</xref></contrib><contrib><name name-style="western"><surname>Zysset</surname><given-names initials="P">Philippe</given-names></name><xref ref-type="aff" rid="aff3">3</xref></contrib><contrib><name name-style="western"><surname>Haeberlin</surname><given-names initials="A">Andreas</given-names></name><xref ref-type="aff" rid="aff1">1</xref><xref ref-type="aff" rid="aff3">3</xref><xref ref-type="aff" rid="aff4">4</xref></contrib><contrib><name name-style="western"><surname>Gräni</surname><given-names initials="C">Christoph</given-names></name><xref ref-type="aff" rid="aff1">1</xref><xref ref-type="aff" rid="aff4">4</xref><xref rid="c001" ref-type="author-notes">*</xref></contrib></contrib-group><aff id="aff1">

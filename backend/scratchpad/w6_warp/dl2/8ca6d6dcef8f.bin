</person-group><publisher-name>Elsevier Academic Press</publisher-name><publisher-loc>Cambridge, MA, USA</publisher-loc><year>2021</year><fpage>1</fpage><lpage>300</lpage><isbn>978-0323852135</isbn></element-citation></ref><ref id="B6-ijms-23-06338"><label>6.</label><element-citation publication-type="journal"><person-group person-group-type="author">
<name name-style="western"><surname>Asyraf</surname><given-names>M.R.M.</given-names></name>
<name name-style="western"><surname>Ishak</surname><given-names>M.R.</given-names></name>

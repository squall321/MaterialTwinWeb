<article xml:lang="en" article-type="research-article" dtd-version="1.4"><processing-meta base-tagset="archiving" mathml-version="3.0" table-model="xhtml" tagset-family="jats"><restricted-by>pmc</restricted-by></processing-meta><front><journal-meta><journal-id journal-id-type="nlm-ta">RSC Adv</journal-id><journal-id journal-id-type="iso-abbrev">RSC Adv</journal-id><journal-id journal-id-type="pmc-domain-id">4079</journal-id><journal-id journal-id-type="pmc-domain">rscadv</journal-id><journal-id journal-id-type="nlm-id">101581657</journal-id><journal-id journal-id-type="publisher-id">RA</journal-id><journal-title-group><journal-title>RSC Advances</journal-title></journal-title-group><issn pub-type="epub">2046-2069</issn><?publisher_abbrev rsc?><publisher><publisher-name>Royal Society of Chemistry</publisher-name></publisher></journal-meta><article-meta><article-id pub-id-type="pmcid">PMC9890669</article-id><article-id pub-id-type="pmcid-ver">PMC9890669.1</article-id><article-id pub-id-type="pmcaid">9890669</article-id><article-id pub-id-type="pmcaiid">9890669</article-id><article-id pub-id-type="pmid">36756605</article-id><article-id pub-id-type="doi">10.1039/d3ra00121k</article-id><article-id pub-id-type="publisher-id">d3ra00121k</article-id><article-version article-version-type="pmc-version">1</article-version><article-categories><subj-group subj-group-type="heading"><subject>Chemistry</subject></subj-group></article-categories><title-group><article-title>Influence of deposition temperature on microstructure and gas-barrier properties of Al<sub>2</sub>O<sub>3</sub> prepared by plasma-enhanced atomic layer deposition on a polycarbonate substrate</article-title></title-group><contrib-group><contrib contrib-type="author" corresp="yes"><contrib-id contrib-id-type="orcid" authenticated="false">https://orcid.org/0000-0001-6330-7163</contrib-id><name name-style="western"><surname>Ren</surname><given-names initials="Y">Yueqing</given-names></name><xref rid="affa" ref-type="aff">a</xref></contrib><contrib contrib-type="author"><name name-style="western"><surname>Sun</surname><given-names initials="X">Xiaojie</given-names></name><xref rid="affa" ref-type="aff">a</xref></contrib><contrib contrib-type="author"><name name-style="western"><surname>Chen</surname><given-names initials="L">Lanlan</given-names></name><xref rid="affa" ref-type="aff">a</xref></contrib><contrib contrib-type="author"><name name-style="western"><surname>Wei</surname><given-names initials="H">Hui</given-names></name><xref rid="affa" ref-type="aff">a</xref></contrib><contrib contrib-type="author"><name name-style="western"><surname>Feng</surname><given-names initials="B">Bo</given-names></name><xref rid="affa" ref-type="aff">a</xref></contrib><contrib contrib-type="author"><name name-style="western"><surname>Chen</surname><given-names initials="J">Jingyun</given-names></name><xref rid="affa" ref-type="aff">a</xref></contrib><aff id="affa">

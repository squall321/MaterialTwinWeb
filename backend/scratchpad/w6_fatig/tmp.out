<script type="text/javascript">
            function currentDate() {
            var today = new Date();
            var months = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December']
            today.setTime(today.getTime());
            return today.getDate() + " " + months[today.getMonth()] + " " + today.getFullYear();
            }
            var citation = 'Pereira, Fábio Gustavo Lima et al. Fracture Behavior and Fatigue Performance of Inconel 625. Materials Research [online]. 2018, v. 21, n. 4 [Accessed CURRENTDATE], e20171089. Available from: &lt;https://doi.org/10.1590/1980-5373-MR-2017-1089&gt;. Epub 25 June 2018. ISSN 1980-5373. https://doi.org/10.1590/1980-5373-MR-2017-1089.'.replace('CURRENTDATE', currentDate());
            document.getElementById('citation').innerHTML = citation;
            document.getElementById('citationCut').value = citation.replace('&lt;', '<').replace('&gt;', ">");
        </script>
</div>

        
      

      

